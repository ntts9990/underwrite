{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:underwrite:contract:promptfoo_row_index.v1",
  "title": "promptfoo_row_index.v1",
  "description": "Content-minimized ordinal triage of supplied Promptfoo source-flag rows.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source",
    "raw_hash",
    "scope",
    "producer_stats",
    "row_tallies",
    "deltas",
    "declared_relation",
    "findings",
    "rows",
    "verification",
    "limitations"
  ],
  "properties": {
    "schema": {
      "const": "promptfoo_row_index.v1"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "format_version"
      ],
      "properties": {
        "format": {
          "const": "promptfoo.eval-output"
        },
        "format_version": {
          "enum": [
            "0.123.0",
            "0.124.1"
          ]
        }
      }
    },
    "raw_hash": {
      "$ref": "#/$defs/hash"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "population",
        "planned_evaluations",
        "export_completeness",
        "values"
      ],
      "properties": {
        "population": {
          "const": "supplied_rows"
        },
        "planned_evaluations": {
          "const": "unknown"
        },
        "export_completeness": {
          "const": "unknown"
        },
        "values": {
          "const": "withheld"
        }
      }
    },
    "producer_stats": {
      "$ref": "#/$defs/counts"
    },
    "row_tallies": {
      "$ref": "#/$defs/counts"
    },
    "deltas": {
      "$ref": "#/$defs/deltas"
    },
    "declared_relation": {
      "enum": [
        "consistent",
        "inconsistent"
      ]
    },
    "findings": {
      "type": "array",
      "maxItems": 2003,
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "rows": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "row_index",
          "category",
          "source_success",
          "source_failure_reason",
          "grading_pass"
        ],
        "properties": {
          "row_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1999
          },
          "category": {
            "enum": [
              "successes",
              "failures",
              "errors"
            ]
          },
          "source_success": {
            "type": "boolean"
          },
          "source_failure_reason": {
            "enum": [
              0,
              1,
              2
            ]
          },
          "grading_pass": {
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "description": "Category is underwrite's source-flag accounting class, not a verified task outcome. Null grading_pass covers both absent and explicit-null gradingResult.",
        "allOf": [
          {
            "if": {
              "properties": {
                "source_success": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "category": {
                  "const": "successes"
                }
              }
            },
            "else": {
              "if": {
                "properties": {
                  "source_failure_reason": {
                    "const": 2
                  }
                }
              },
              "then": {
                "properties": {
                  "category": {
                    "const": "errors"
                  }
                }
              },
              "else": {
                "properties": {
                  "category": {
                    "const": "failures"
                  }
                }
              }
            }
          }
        ]
      }
    },
    "verification": {
      "const": []
    },
    "limitations": {
      "const": [
        "SOURCE_CLAIMS_UNVERIFIED",
        "ERROR_CAUSE_UNKNOWN",
        "PLANNED_EVALUATIONS_UNKNOWN",
        "EXPORT_COMPLETENESS_UNKNOWN",
        "SOURCE_CONTENT_WITHHELD",
        "SOURCE_HASH_AND_ROW_PATTERN_LINKABLE",
        "NO_TASK_VERDICT_OR_APPROVAL_AUTHORITY"
      ]
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "successes",
        "failures",
        "errors",
        "total"
      ],
      "properties": {
        "successes": {
          "$ref": "#/$defs/nonnegative"
        },
        "failures": {
          "$ref": "#/$defs/nonnegative"
        },
        "errors": {
          "$ref": "#/$defs/nonnegative"
        },
        "total": {
          "$ref": "#/$defs/nonnegative"
        }
      }
    },
    "deltas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "successes",
        "failures",
        "errors",
        "total"
      ],
      "properties": {
        "successes": {
          "$ref": "#/$defs/signed"
        },
        "failures": {
          "$ref": "#/$defs/signed"
        },
        "errors": {
          "$ref": "#/$defs/signed"
        },
        "total": {
          "$ref": "#/$defs/signed"
        }
      }
    },
    "nonnegative": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740992
    },
    "signed": {
      "type": "integer",
      "minimum": -9007199254740992,
      "maximum": 9007199254740992
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "row_index",
        "location"
      ],
      "properties": {
        "code": {
          "enum": [
            "CATEGORY_COUNT_MISMATCH",
            "SOURCE_FLAGS_DISAGREE"
          ]
        },
        "row_index": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 1999
        },
        "location": {
          "type": "string",
          "pattern": "^/results/(?:stats/(?:successes|failures|errors)|results/(?:0|[1-9][0-9]{0,3})/(?:failureReason|gradingResult/pass))$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "code": {
                "const": "CATEGORY_COUNT_MISMATCH"
              }
            }
          },
          "then": {
            "properties": {
              "row_index": {
                "type": "null"
              },
              "location": {
                "pattern": "^/results/stats/(?:successes|failures|errors)$"
              }
            }
          },
          "else": {
            "properties": {
              "row_index": {
                "type": "integer"
              },
              "location": {
                "pattern": "^/results/results/(?:0|[1-9][0-9]{0,3})/(?:failureReason|gradingResult/pass)$"
              }
            }
          }
        }
      ]
    }
  }
}
