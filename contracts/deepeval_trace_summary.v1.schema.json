{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:underwrite:contract:deepeval_trace_summary.v1",
  "title": "deepeval_trace_summary.v1",
  "description": "Content-minimized source-claimed DeepEval trace and span populations. Coordinates and parent pointers are omitted; links do not establish causality.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source",
    "raw_hash",
    "rule_profile",
    "scope",
    "counts",
    "limitations",
    "next_actions",
    "reader_profile",
    "view",
    "detail_state"
  ],
  "properties": {
    "schema": {
      "const": "deepeval_trace_summary.v1"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "producer_version",
        "producer_version_state",
        "claims_verified"
      ],
      "properties": {
        "format": {
          "const": "deepeval.test-run"
        },
        "producer_version": {
          "type": "null"
        },
        "producer_version_state": {
          "const": "unknown"
        },
        "claims_verified": {
          "const": false
        }
      }
    },
    "raw_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
    },
    "rule_profile": {
      "const": "deepeval.trace-index.v1"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "case_roster",
        "selected_fields_only",
        "planned_steps",
        "instrumentation_completeness",
        "source_claims_verified",
        "expectations",
        "dataset_version"
      ],
      "properties": {
        "unit": {
          "const": "observed_span"
        },
        "case_roster": {
          "const": "supplied_test_cases"
        },
        "selected_fields_only": {
          "const": true
        },
        "planned_steps": {
          "const": "unknown"
        },
        "instrumentation_completeness": {
          "const": "unknown"
        },
        "source_claims_verified": {
          "const": false
        },
        "expectations": {
          "const": "not_analyzed"
        },
        "dataset_version": {
          "const": "not_analyzed"
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cases",
        "traces",
        "spans"
      ],
      "properties": {
        "cases": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total",
            "source_true",
            "source_false",
            "source_unknown"
          ],
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 512
            },
            "source_true": {
              "type": "integer",
              "minimum": 0,
              "maximum": 512
            },
            "source_false": {
              "type": "integer",
              "minimum": 0,
              "maximum": 512
            },
            "source_unknown": {
              "type": "integer",
              "minimum": 0,
              "maximum": 512
            }
          }
        },
        "traces": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "absent",
            "null",
            "present",
            "status_success",
            "status_errored",
            "status_unknown"
          ],
          "properties": {
            "absent": {
              "type": "integer",
              "minimum": 0,
              "maximum": 512
            },
            "null": {
              "type": "integer",
              "minimum": 0,
              "maximum": 512
            },
            "present": {
              "type": "integer",
              "minimum": 0,
              "maximum": 512
            },
            "status_success": {
              "type": "integer",
              "minimum": 0,
              "maximum": 512
            },
            "status_errored": {
              "type": "integer",
              "minimum": 0,
              "maximum": 512
            },
            "status_unknown": {
              "type": "integer",
              "minimum": 0,
              "maximum": 512
            }
          }
        },
        "spans": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total",
            "by_group",
            "by_declared_type",
            "status_success",
            "status_errored",
            "parent_resolved",
            "parent_unresolved",
            "parent_not_reported",
            "cycle_members",
            "group_type_mismatch"
          ],
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1024
            },
            "by_group": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "baseSpans",
                "agentSpans",
                "llmSpans",
                "retrieverSpans",
                "toolSpans"
              ],
              "properties": {
                "baseSpans": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                },
                "agentSpans": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                },
                "llmSpans": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                },
                "retrieverSpans": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                },
                "toolSpans": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                }
              }
            },
            "by_declared_type": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "base",
                "agent",
                "llm",
                "retriever",
                "tool"
              ],
              "properties": {
                "base": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                },
                "agent": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                },
                "llm": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                },
                "retriever": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                },
                "tool": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                }
              }
            },
            "status_success": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1024
            },
            "status_errored": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1024
            },
            "parent_resolved": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1024
            },
            "parent_unresolved": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1024
            },
            "parent_not_reported": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1024
            },
            "cycle_members": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1024
            },
            "group_type_mismatch": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1024
            }
          }
        }
      }
    },
    "limitations": {
      "const": [
        "SOURCE_CLAIMS_UNVERIFIED",
        "SELECTED_FIELDS_ONLY",
        "PLANNED_STEPS_UNKNOWN",
        "INSTRUMENTATION_COMPLETENESS_UNKNOWN",
        "METRICS_AND_TIMING_NOT_ANALYZED",
        "PARENT_LINKS_NOT_CAUSAL_DEPENDENCIES",
        "NO_RETRY_OR_CHRONOLOGY_INFERENCE",
        "SOURCE_HASH_LINKABLE",
        "NO_STATISTICAL_OR_APPROVAL_AUTHORITY",
        "SOURCE_VERSION_UNKNOWN",
        "EXPECTATIONS_NOT_ANALYZED",
        "SOURCE_CASE_SUCCESS_UNINTERPRETED",
        "DATASET_VERSION_NOT_ANALYZED"
      ]
    },
    "next_actions": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "enum": [
          "INSPECT_ERRORED_STEP_CONTEXT",
          "RESOLVE_UNBOUND_PARENT_REFERENCES",
          "INSPECT_CYCLIC_PARENT_LINKS",
          "CHECK_INSTRUMENTATION_COVERAGE_IF_NEEDED"
        ]
      },
      "uniqueItems": true
    },
    "reader_profile": {
      "const": "deepeval.trace-structure.selected-fields.v1"
    },
    "view": {
      "const": "trace-summary"
    },
    "detail_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_coordinates",
        "span_coordinates",
        "parent_pointers",
        "full_view"
      ],
      "properties": {
        "case_coordinates": {
          "const": "intentionally_omitted"
        },
        "span_coordinates": {
          "const": "intentionally_omitted"
        },
        "parent_pointers": {
          "const": "intentionally_omitted"
        },
        "full_view": {
          "const": "audit-deepeval --view trace-index"
        }
      }
    }
  }
}
