        "reason": {
          "type": "string"
        },
        "location": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^(?:|/(?:root|store|record_id|spec(?:/(?:files|links)(?:/[0-9]+(?:/[a-z_]+)?)?)?|source_base|record|catalog|verification|output))(?![\\s\\S])"
        },
        "next_action": {
          "type": "string"
        },
        "retryable": {
          "const": false
        },
        "exit_code": {
          "const": 2
        }
      },
      "oneOf": [
