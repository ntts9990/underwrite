  "$defs": {
    "record_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,95}(?![\\s\\S])"
    },
    "kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}(?![\\s\\S])"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "complete": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "state",
        "manifest_digest",
        "kind"
      ],
      "properties": {
        "record_id": {
          "$ref": "#/$defs/record_id"
        },
        "state": {
          "const": "complete"
        },
        "manifest_digest": {
          "$ref": "#/$defs/digest"
        },
        "kind": {
          "$ref": "#/$defs/kind"
        }
      }
    },
    "unpublished": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "state"
      ],
      "properties": {
        "record_id": {
          "$ref": "#/$defs/record_id"
        },
        "state": {
          "const": "unpublished"
        }
      }
    }
