{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:underwrite:contract:deepeval_accounting.v1",
  "title": "deepeval_accounting.v1",
  "description": "Descriptive source accounting; no measurement or approval authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "rule_profile",
    "source",
    "raw_hash",
    "observation_digest",
    "scope",
    "cases",
    "counts",
    "declared_case_counts",
    "limitations",
    "next_actions"
  ],
  "properties": {
    "schema": {
      "const": "deepeval_accounting.v1"
    },
    "rule_profile": {
      "const": "deepeval.metric-accounting.v1"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "format_version",
        "claims_verified"
      ],
      "properties": {
        "format": {
          "const": "deepeval.test-run"
        },
        "format_version": {
          "const": "4.1.1"
        },
        "claims_verified": {
          "const": false
        }
      }
    },
    "raw_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
    },
    "observation_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "test_cases",
        "conversational",
        "trace",
        "metric_aggregates",
        "planned_inventory"
      ],
      "properties": {
        "unit": {
          "const": "metric_occurrence_within_test_case"
        },
        "test_cases": {
          "const": "included"
        },
        "conversational": {
          "const": "absent_or_empty"
        },
        "trace": {
          "const": "absent_or_empty"
        },
        "metric_aggregates": {
          "const": "not_checked"
        },
        "planned_inventory": {
          "const": "unknown"
        }
      }
    },
    "cases": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_index",
          "name",
          "order",
          "source_success",
          "metrics"
        ],
        "properties": {
          "case_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 511
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "order": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "present"
                ],
                "properties": {
                  "present": {
                    "const": false
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "present",
                  "value"
                ],
                "properties": {
                  "present": {
                    "const": true
                  },
                  "value": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740992
                  }
                }
              }
            ]
          },
          "source_success": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "null denotes an absent source success key; a present null source flag is rejected."
          },
          "metrics": {
            "type": "array",
            "maxItems": 2048,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "metric_index",
                    "name",
                    "state",
                    "applied_rule",
                    "source_success",
                    "threshold",
                    "score"
                  ],
                  "properties": {
                    "metric_index": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 2047
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "state": {
                      "const": "scored"
                    },
                    "applied_rule": {
                      "const": "SCORE_PRESENT"
                    },
                    "source_success": {
                      "type": "boolean"
                    },
                    "threshold": {
                      "type": "number"
                    },
                    "score": {
                      "type": "number"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "metric_index",
                    "name",
                    "state",
                    "applied_rule",
                    "source_success",
                    "threshold",
                    "error"
                  ],
                  "properties": {
                    "metric_index": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 2047
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "state": {
                      "const": "error"
                    },
                    "applied_rule": {
                      "const": "ERROR_PRESENT"
                    },
                    "source_success": {
                      "type": "boolean"
                    },
                    "threshold": {
                      "type": "number"
                    },
                    "error": {
                      "type": "string",
                      "maxLength": 1024
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "metric_index",
                    "name",
                    "state",
                    "applied_rule",
                    "source_success",
                    "threshold"
                  ],
                  "properties": {
                    "metric_index": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 2047
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "state": {
                      "const": "unscored"
                    },
                    "applied_rule": {
                      "const": "SCORE_AND_ERROR_ABSENT"
                    },
                    "source_success": {
                      "type": "boolean"
                    },
                    "threshold": {
                      "type": "number"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cases",
        "metrics"
      ],
      "properties": {
        "cases": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total",
            "source_true",
            "source_false",
            "source_success_absent"
          ],
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 512
            },
            "source_true": {
              "type": "integer",
              "minimum": 0,
              "maximum": 512
            },
            "source_false": {
              "type": "integer",
              "minimum": 0,
              "maximum": 512
            },
            "source_success_absent": {
              "type": "integer",
              "minimum": 0,
              "maximum": 512
            }
          }
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total",
            "scored",
            "error",
            "unscored",
            "observed_zero",
            "scored_source_true",
            "scored_source_false"
          ],
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2048
            },
            "scored": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2048
            },
            "error": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2048
            },
            "unscored": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2048
            },
            "observed_zero": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2048
            },
            "scored_source_true": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2048
            },
            "scored_source_false": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2048
            }
          }
        }
      }
    },
    "declared_case_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "failed",
        "comparison"
      ],
      "properties": {
        "passed": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "present"
              ],
              "properties": {
                "present": {
                  "const": false
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "present",
                "value"
              ],
              "properties": {
                "present": {
                  "const": true
                },
                "value": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740992
                }
              }
            }
          ]
        },
        "failed": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "present"
              ],
              "properties": {
                "present": {
                  "const": false
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "present",
                "value"
              ],
              "properties": {
                "present": {
                  "const": true
                },
                "value": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740992
                }
              }
            }
          ]
        },
        "comparison": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "passed",
            "failed"
          ],
          "properties": {
            "passed": {
              "enum": [
                "matches",
                "differs",
                "not_declared",
                "not_comparable"
              ]
            },
            "failed": {
              "enum": [
                "matches",
                "differs",
                "not_declared",
                "not_comparable"
              ]
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "const": [
        "SOURCE_CLAIMS_UNVERIFIED",
        "PLANNED_INVENTORY_UNKNOWN",
        "METRIC_AGGREGATES_NOT_CHECKED",
        "NO_CAUSAL_FAILURE_ATTRIBUTION",
        "NO_STATISTICAL_OR_APPROVAL_AUTHORITY"
      ],
      "maxItems": 5,
      "items": {
        "enum": [
          "SOURCE_CLAIMS_UNVERIFIED",
          "PLANNED_INVENTORY_UNKNOWN",
          "METRIC_AGGREGATES_NOT_CHECKED",
          "NO_CAUSAL_FAILURE_ATTRIBUTION",
          "NO_STATISTICAL_OR_APPROVAL_AUTHORITY"
        ]
      }
    },
    "next_actions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string",
        "enum": [
          "INSPECT_EVALUATOR_ERRORS",
          "SUPPLY_PLANNED_INVENTORY_FOR_MISSINGNESS",
          "CHECK_PRODUCER_CASE_COUNTS"
        ]
      },
      "uniqueItems": true
    }
  }
}
