{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:underwrite:contract:declared_comparison_case.v1",
  "title": "declared_comparison_case.v1",
  "description": "Caller-supplied declarations bound to two accounting reports; not observed execution conditions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "baseline", "candidate"],
  "properties": {
    "schema": {"const": "declared_comparison_case.v1"},
    "baseline": {"$ref": "#/$defs/side"},
    "candidate": {"$ref": "#/$defs/side"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "text": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
    "number": {"type": ["number", "null"], "minimum": -1000000, "maximum": 1000000},
    "integer": {"type": ["integer", "null"], "minimum": -9007199254740991, "maximum": 9007199254740991},
    "side": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audit_digest", "run_ref", "conditions", "metric"],
      "properties": {
        "audit_digest": {"$ref": "#/$defs/hash"},
        "run_ref": {"type": "string", "minLength": 1, "maxLength": 256},
        "conditions": {"$ref": "#/$defs/conditions"},
        "metric": {"$ref": "#/$defs/metric"}
      }
    },
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "suite": {"$ref": "#/$defs/text"},
        "prompt_version": {"$ref": "#/$defs/text"},
        "model": {"$ref": "#/$defs/text"},
        "gen_params": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "temperature": {"$ref": "#/$defs/number"},
            "top_p": {"$ref": "#/$defs/number"},
            "max_tokens": {"$ref": "#/$defs/integer"},
            "think": {"$ref": "#/$defs/text"},
            "seed": {"$ref": "#/$defs/integer"},
            "num_ctx": {"$ref": "#/$defs/integer"},
            "timeout_s": {"$ref": "#/$defs/number"}
          }
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"$ref": "#/$defs/text"},
        "unit": {"$ref": "#/$defs/text"},
        "higher_is_better": {"type": ["boolean", "null"]},
        "scope": {"$ref": "#/$defs/text"},
        "denominator": {"$ref": "#/$defs/text"},
        "aggregation": {"$ref": "#/$defs/text"},
        "evaluator": {"$ref": "#/$defs/text"},
        "evaluator_version": {"$ref": "#/$defs/text"},
        "policy": {"$ref": "#/$defs/text"},
        "threshold": {"$ref": "#/$defs/number"}
      }
    }
  }
}
