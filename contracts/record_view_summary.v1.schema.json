{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:underwrite:contract:record_view_summary.v1",
  "title": "record_view_summary.v1",
  "description": "Content-minimized manifest metadata for one published local record. Stored file bytes and linked records are not verified.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "view",
    "manifest_state",
    "manifest_digest",
    "record_id",
    "kind",
    "captured_at",
    "selection",
    "rerun_verification_status",
    "provenance_verified",
    "attestation_reference_state",
    "file_count",
    "file_role_counts",
    "declared_file_bytes",
    "file_offset",
    "file_page_size",
    "files",
    "next_file_page",
    "restart_offset",
    "next_action",
    "link_relation_counts",
    "verification_scope",
    "limitations",
    "detail_state"
  ],
  "properties": {
    "schema": {
      "const": "record_view_summary.v1"
    },
    "view": {
      "const": "summary"
    },
    "manifest_state": {
      "enum": [
        "observed",
        "changed"
      ]
    },
    "manifest_digest": {
      "$ref": "#/$defs/digest"
    },
    "record_id": {
      "$ref": "#/$defs/record_id"
    },
    "kind": {
      "$ref": "#/$defs/kind"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z(?![\\s\\S])"
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "excluded_state",
        "excluded_count"
      ],
      "properties": {
        "scope": {
          "const": "explicit_files"
        },
        "excluded_state": {
          "enum": [
            "not_declared",
            "declared"
          ]
        },
        "excluded_count": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 32
            }
          ]
        }
      }
    },
    "rerun_verification_status": {
      "enum": [
        "not_performed",
        "referenced"
      ]
    },
    "provenance_verified": {
      "const": false
    },
    "attestation_reference_state": {
      "enum": [
        "absent",
        "declared_unverified"
      ]
    },
    "file_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "file_role_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "input",
        "policy",
        "result",
        "verification",
        "code",
        "log",
        "environment"
      ],
      "properties": {
        "source": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "input": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "policy": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "result": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "verification": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "code": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "log": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "environment": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        }
      }
    },
    "declared_file_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 536870912
    },
    "file_offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 48,
      "multipleOf": 16
    },
    "file_page_size": {
      "const": 16
    },
    "files": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "role",
          "media_type",
          "declared_sha256",
          "declared_bytes"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/logical_name"
          },
          "role": {
            "$ref": "#/$defs/role"
          },
          "media_type": {
            "$ref": "#/$defs/media_type"
          },
          "declared_sha256": {
            "$ref": "#/$defs/digest"
          },
          "declared_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 134217728
          }
        }
      },
      "uniqueItems": true
    },
    "next_file_page": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "offset"
          ],
          "properties": {
            "offset": {
              "type": "integer",
              "minimum": 16,
              "maximum": 48,
              "multipleOf": 16
            }
          }
        }
      ]
    },
    "restart_offset": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "const": 0
        }
      ]
    },
    "next_action": {
      "enum": [
        "FOLLOW_NEXT_FILE_PAGE_OR_SELECT_NAME",
        "SELECT_NAME_OR_FINISH",
        "RESTART_FROM_FIRST_FILE_PAGE"
      ]
    },
    "link_relation_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "related"
      ],
      "properties": {
        "input": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "related": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        }
      }
    },
    "verification_scope": {
      "const": "canonical_published_manifest_only"
    },
    "limitations": {
      "const": [
        "STORED_FILE_BYTES_NOT_READ_OR_VERIFIED",
        "DIRECT_LINK_TARGETS_NOT_READ_OR_VERIFIED",
        "SOURCE_PROVENANCE_NOT_ESTABLISHED",
        "RERUN_REFERENCE_NOT_EXECUTED_NOW",
        "NO_APPROVAL_AUTHORITY"
      ]
    },
    "detail_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "metadata",
        "source_locators",
        "link_targets",
        "artifact_references",
        "full_view"
      ],
      "properties": {
        "label": {
          "const": "intentionally_omitted"
        },
        "metadata": {
          "const": "intentionally_omitted"
        },
        "source_locators": {
          "const": "intentionally_omitted"
        },
        "link_targets": {
          "const": "intentionally_omitted"
        },
        "artifact_references": {
          "const": "intentionally_omitted"
        },
        "full_view": {
          "const": "records show --view full"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "selection": {
            "properties": {
              "excluded_state": {
                "const": "not_declared"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "selection": {
            "properties": {
              "excluded_count": {
                "type": "null"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "selection": {
            "properties": {
              "excluded_count": {
                "type": "integer"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "manifest_state": {
            "const": "changed"
          }
        }
      },
      "then": {
        "properties": {
          "files": {
            "maxItems": 0
          },
          "next_file_page": {
            "type": "null"
          },
          "restart_offset": {
            "const": 0
          },
          "next_action": {
            "const": "RESTART_FROM_FIRST_FILE_PAGE"
          }
        }
      },
      "else": {
        "properties": {
          "files": {
            "minItems": 1
          },
          "restart_offset": {
            "type": "null"
          },
          "next_action": {
            "enum": [
              "FOLLOW_NEXT_FILE_PAGE_OR_SELECT_NAME",
              "SELECT_NAME_OR_FINISH"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "next_action": {
            "const": "FOLLOW_NEXT_FILE_PAGE_OR_SELECT_NAME"
          }
        }
      },
      "then": {
        "properties": {
          "files": {
            "minItems": 16
          },
          "next_file_page": {
            "type": "object"
          }
        },
        "oneOf": [
          {
            "properties": {
              "file_offset": {
                "const": 0
              },
              "file_count": {
                "minimum": 17
              },
              "next_file_page": {
                "properties": {
                  "offset": {
                    "const": 16
                  }
                }
              }
            }
          },
          {
            "properties": {
              "file_offset": {
                "const": 16
              },
              "file_count": {
                "minimum": 33
              },
              "next_file_page": {
                "properties": {
                  "offset": {
                    "const": 32
                  }
                }
              }
            }
          },
          {
            "properties": {
              "file_offset": {
                "const": 32
              },
              "file_count": {
                "minimum": 49
              },
              "next_file_page": {
                "properties": {
                  "offset": {
                    "const": 48
                  }
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "next_action": {
            "const": "SELECT_NAME_OR_FINISH"
          }
        }
      },
      "then": {
        "properties": {
          "files": {
            "minItems": 1
          },
          "next_file_page": {
            "type": "null"
          }
        },
        "oneOf": [
          {
            "properties": {
              "file_offset": {
                "const": 0
              },
              "file_count": {
                "minimum": 1,
                "maximum": 16
              }
            }
          },
          {
            "properties": {
              "file_offset": {
                "const": 16
              },
              "file_count": {
                "minimum": 17,
                "maximum": 32
              }
            }
          },
          {
            "properties": {
              "file_offset": {
                "const": 32
              },
              "file_count": {
                "minimum": 33,
                "maximum": 48
              }
            }
          },
          {
            "properties": {
              "file_offset": {
                "const": 48
              },
              "file_count": {
                "minimum": 49,
                "maximum": 64
              }
            }
          }
        ]
      }
    }
  ],
  "$defs": {
    "record_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,95}(?![\\s\\S])"
    },
    "kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}(?![\\s\\S])"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "logical_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*(?![\\s\\S])"
    },
    "role": {
      "enum": [
        "source",
        "input",
        "policy",
        "result",
        "verification",
        "code",
        "log",
        "environment"
      ]
    },
    "media_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[\\u0021-\\u007e]+(?![\\s\\S])"
    }
  }
}
