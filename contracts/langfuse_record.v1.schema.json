{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:underwrite:contract:langfuse_record.v1",
  "title": "langfuse_record.v1",
  "description": "Independent Langfuse accounting and private capture outcomes. A saved record verifies stored bytes, not producer execution or approval. Null published_record means no identity was returned, not proven absence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "command",
    "sources",
    "analysis",
    "storage",
    "exit_code"
  ],
  "properties": {
    "schema": {
      "const": "langfuse_record.v1"
    },
    "command": {
      "const": "records audit-langfuse"
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observations",
        "scores"
      ],
      "properties": {
        "observations": {
          "$ref": "#/$defs/source"
        },
        "scores": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "analysis": {
      "$ref": "#/$defs/analysis"
    },
    "storage": {
      "$ref": "#/$defs/storage"
    },
    "exit_code": {
      "enum": [
        0,
        2,
        3
      ]
    }
  },
  "$defs": {
    "langfuse_accounting": {
      "title": "langfuse_accounting.v1",
      "description": "Supplied score rows and exact field links; no task verdict.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "rule_profile",
        "sources",
        "scope",
        "observations",
        "scores",
        "counts",
        "planned",
        "limitations",
        "next_actions"
      ],
      "properties": {
        "schema": {
          "const": "langfuse_accounting.v1"
        },
        "rule_profile": {
          "const": "langfuse.score-accounting.v1"
        },
        "sources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "observations",
            "scores"
          ],
          "properties": {
            "observations": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "format",
                "format_version",
                "raw_hash",
                "observation_digest",
                "claims_verified"
              ],
              "properties": {
                "format": {
                  "const": "langfuse.observations-v2"
                },
                "format_version": {
                  "const": "4.35.0"
                },
                "raw_hash": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
                },
                "observation_digest": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
                },
                "claims_verified": {
                  "const": false
                }
              }
            },
            "scores": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "format",
                "format_version",
                "raw_hash",
                "observation_digest",
                "claims_verified"
              ],
              "properties": {
                "format": {
                  "const": "langfuse.scores"
                },
                "format_version": {
                  "const": "4.35.0"
                },
                "raw_hash": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
                },
                "observation_digest": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
                },
                "claims_verified": {
                  "const": false
                }
              }
            }
          }
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "population",
            "export_completeness",
            "planned_evaluations",
            "unit",
            "claims_verified",
            "display_text"
          ],
          "properties": {
            "population": {
              "const": "supplied_rows"
            },
            "export_completeness": {
              "const": "unknown"
            },
            "planned_evaluations": {
              "const": "unknown"
            },
            "unit": {
              "const": "score_row"
            },
            "claims_verified": {
              "const": false
            },
            "display_text": {
              "const": "nfc_normalized"
            }
          }
        },
        "observations": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "observation_index",
              "id",
              "project_id",
              "trace_id",
              "type",
              "local_score_count"
            ],
            "properties": {
              "observation_index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 511
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "project_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "trace_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "type": {
                "type": "string",
                "maxLength": 256
              },
              "local_score_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2048
              }
            }
          }
        },
        "scores": {
          "type": "array",
          "maxItems": 2048,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "score_index",
              "id",
              "project_id",
              "trace_id",
              "observation_id",
              "name",
              "data_type",
              "value",
              "string_value",
              "kind_rule",
              "association",
              "association_rule",
              "target_observation_index"
            ],
            "properties": {
              "score_index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2047
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "project_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "trace_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "observation_id": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 256
              },
              "name": {
                "type": "string",
                "maxLength": 256
              },
              "data_type": {
                "enum": [
                  "NUMERIC",
                  "BOOLEAN",
                  "CATEGORICAL",
                  "TEXT"
                ]
              },
              "value": {
                "type": "number"
              },
              "string_value": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 1024
              },
              "kind_rule": {
                "enum": [
                  "NUMERIC_SCORE",
                  "BOOLEAN_SCORE",
                  "CATEGORICAL_SCORE",
                  "TEXT_SCORE"
                ]
              },
              "association": {
                "enum": [
                  "observation_local",
                  "trace_level",
                  "unresolved_observation_reference"
                ]
              },
              "association_rule": {
                "enum": [
                  "MATCHED_OBSERVATION_SCORE",
                  "TRACE_LEVEL_SCORE",
                  "UNRESOLVED_OBSERVATION_SCORE"
                ]
              },
              "target_observation_index": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 511
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "data_type": {
                      "const": "NUMERIC"
                    }
                  },
                  "required": [
                    "data_type"
                  ]
                },
                "then": {
                  "properties": {
                    "kind_rule": {
                      "const": "NUMERIC_SCORE"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "data_type": {
                      "const": "BOOLEAN"
                    }
                  },
                  "required": [
                    "data_type"
                  ]
                },
                "then": {
                  "properties": {
                    "kind_rule": {
                      "const": "BOOLEAN_SCORE"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "data_type": {
                      "const": "CATEGORICAL"
                    }
                  },
                  "required": [
                    "data_type"
                  ]
                },
                "then": {
                  "properties": {
                    "kind_rule": {
                      "const": "CATEGORICAL_SCORE"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "data_type": {
                      "const": "TEXT"
                    }
                  },
                  "required": [
                    "data_type"
                  ]
                },
                "then": {
                  "properties": {
                    "kind_rule": {
                      "const": "TEXT_SCORE"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "association": {
                      "const": "observation_local"
                    }
                  },
                  "required": [
                    "association"
                  ]
                },
                "then": {
                  "properties": {
                    "association_rule": {
                      "const": "MATCHED_OBSERVATION_SCORE"
                    },
                    "observation_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "target_observation_index": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 511
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "association": {
                      "const": "trace_level"
                    }
                  },
                  "required": [
                    "association"
                  ]
                },
                "then": {
                  "properties": {
                    "association_rule": {
                      "const": "TRACE_LEVEL_SCORE"
                    },
                    "observation_id": {
                      "type": "null"
                    },
                    "target_observation_index": {
                      "type": "null"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "association": {
                      "const": "unresolved_observation_reference"
                    }
                  },
                  "required": [
                    "association"
                  ]
                },
                "then": {
                  "properties": {
                    "association_rule": {
                      "const": "UNRESOLVED_OBSERVATION_SCORE"
                    },
                    "observation_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "target_observation_index": {
                      "type": "null"
                    }
                  }
                }
              }
            ]
          }
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "observations",
            "scores",
            "by_data_type",
            "associations",
            "observations_without_local_scores"
          ],
          "properties": {
            "observations": {
              "type": "integer",
              "minimum": 0,
              "maximum": 512
            },
            "scores": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2048
            },
            "by_data_type": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "NUMERIC",
                "BOOLEAN",
                "CATEGORICAL",
                "TEXT"
              ],
              "properties": {
                "NUMERIC": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2048
                },
                "BOOLEAN": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2048
                },
                "CATEGORICAL": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2048
                },
                "TEXT": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2048
                }
              }
            },
            "associations": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "observation_local",
                "trace_level",
                "unresolved_observation_reference"
              ],
              "properties": {
                "observation_local": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2048
                },
                "trace_level": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2048
                },
                "unresolved_observation_reference": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2048
                }
              }
            },
            "observations_without_local_scores": {
              "type": "integer",
              "minimum": 0,
              "maximum": 512
            }
          }
        },
        "planned": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "count",
            "missing_execution_count"
          ],
          "properties": {
            "status": {
              "const": "unknown"
            },
            "count": {
              "const": null
            },
            "missing_execution_count": {
              "const": null
            }
          }
        },
        "limitations": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string",
            "enum": [
              "SOURCE_CLAIMS_UNVERIFIED",
              "EXPORT_COMPLETENESS_UNKNOWN",
              "PLANNED_EVALUATIONS_UNKNOWN",
              "SCORE_VALUES_NOT_TASK_VERDICTS",
              "NO_STATISTICAL_OR_APPROVAL_AUTHORITY"
            ]
          },
          "const": [
            "SOURCE_CLAIMS_UNVERIFIED",
            "EXPORT_COMPLETENESS_UNKNOWN",
            "PLANNED_EVALUATIONS_UNKNOWN",
            "SCORE_VALUES_NOT_TASK_VERDICTS",
            "NO_STATISTICAL_OR_APPROVAL_AUTHORITY"
          ]
        },
        "next_actions": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "string",
            "enum": [
              "SUPPLY_PLANNED_INVENTORY_FOR_MISSINGNESS",
              "INSPECT_UNRESOLVED_OBSERVATION_REFERENCES"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "evidence_error": {
      "title": "evidence_error.v1",
      "description": "Invocation or input failure of an evidence pilot command. No successful report was emitted. This is not a measurement verdict.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "code",
        "reason",
        "location",
        "next_action",
        "retryable",
        "exit_code"
      ],
      "properties": {
        "schema": {
          "const": "evidence_error.v1"
        },
        "code": {
          "enum": [
            "USAGE_ERROR",
            "INVALID_INPUT",
            "SOURCE_READ_FAILED",
            "INPUT_LIMIT_EXCEEDED",
            "OUTPUT_LIMIT_EXCEEDED",
            "UNSUPPORTED_PROFILE",
            "UNSUPPORTED_FORMAT",
            "EXPECTED_HASH_MISMATCH",
            "INVALID_MANIFEST",
            "INVALID_ARTIFACT_PATH",
            "SCHEMA_CONFIGURATION_ERROR",
            "COMPUTATION_LIMIT_EXCEEDED",
            "INTERNAL_ERROR",
            "UNSUPPORTED_PLATFORM",
            "INPUT_BINDING_MISMATCH"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Z][A-Z0-9_]*(?![\\s\\S])"
        },
        "location": {
          "type": "string",
          "maxLength": 512
        },
        "next_action": {
          "enum": [
            "CORRECT_ARGUMENTS",
            "CORRECT_INPUT",
            "PROVIDE_REGULAR_LOCAL_FILE",
            "REDUCE_INPUT_SIZE",
            "USE_SUPPORTED_PROFILE",
            "CHECK_EXPECTED_HASH",
            "CORRECT_MANIFEST",
            "CORRECT_ARTIFACT",
            "REINSTALL_PACKAGE",
            "REDUCE_COMPUTATION",
            "REPORT_INTERNAL_ERROR",
            "USE_SUPPORTED_PLATFORM",
            "CORRECT_INPUT_BINDING"
          ]
        },
        "retryable": {
          "const": false
        },
        "exit_code": {
          "const": 2
        }
      }
    },
    "record_error": {
      "title": "record_error.v1",
      "description": "Finite records command failure without caller-supplied diagnostics.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "code",
        "reason",
        "location",
        "next_action",
        "retryable",
        "exit_code"
      ],
      "properties": {
        "schema": {
          "const": "record_error.v1"
        },
        "code": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "location": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^(?:|/(?:root|store|record_id|spec(?:/(?:files|links)(?:/[0-9]+(?:/[a-z_]+)?)?)?|source_base|record|catalog|verification|output))(?![\\s\\S])"
        },
        "next_action": {
          "type": "string"
        },
        "retryable": {
          "const": false
        },
        "exit_code": {
          "const": 2
        }
      },
      "oneOf": [
        {
          "$ref": "#/$defs/record_error__INVALID_SPEC"
        },
        {
          "$ref": "#/$defs/record_error__INVALID_RECORD"
        },
        {
          "$ref": "#/$defs/record_error__INVALID_STORE_LAYOUT"
        },
        {
          "$ref": "#/$defs/record_error__INSECURE_STORE"
        },
        {
          "$ref": "#/$defs/record_error__STORE_NOT_FOUND"
        },
        {
          "$ref": "#/$defs/record_error__RECORD_NOT_FOUND"
        },
        {
          "$ref": "#/$defs/record_error__RECORD_EXISTS"
        },
        {
          "$ref": "#/$defs/record_error__RECORD_CAPTURE_INCOMPLETE"
        },
        {
          "$ref": "#/$defs/record_error__RECORD_NOT_PUBLISHED"
        },
        {
          "$ref": "#/$defs/record_error__SOURCE_READ_FAILED"
        },
        {
          "$ref": "#/$defs/record_error__INPUT_LIMIT_EXCEEDED"
        },
        {
          "$ref": "#/$defs/record_error__RECORD_LIMIT_EXCEEDED"
        },
        {
          "$ref": "#/$defs/record_error__STORE_IO_ERROR"
        },
        {
          "$ref": "#/$defs/record_error__UNSUPPORTED_PLATFORM"
        },
        {
          "$ref": "#/$defs/record_error__USAGE_ERROR"
        },
        {
          "$ref": "#/$defs/record_error__SCHEMA_CONFIGURATION_ERROR"
        },
        {
          "$ref": "#/$defs/record_error__OUTPUT_LIMIT_EXCEEDED"
        },
        {
          "$ref": "#/$defs/record_error__INTERNAL_ERROR"
        },
        {
          "$ref": "#/$defs/record_error__RECORD_FILE_NOT_FOUND"
        },
        {
          "$ref": "#/$defs/record_error__RECORD_FILE_INTEGRITY_MISMATCH"
        },
        {
          "$ref": "#/$defs/record_error__UNSUPPORTED_RECORD_CONTENT"
        }
      ]
    },
    "record_error__INVALID_SPEC": {
      "properties": {
        "code": {
          "const": "INVALID_SPEC"
        },
        "reason": {
          "const": "INVALID_RECORD_SPEC"
        },
        "next_action": {
          "const": "CORRECT_RECORD_SPEC"
        }
      }
    },
    "record_error__INVALID_RECORD": {
      "properties": {
        "code": {
          "const": "INVALID_RECORD"
        },
        "reason": {
          "const": "INVALID_RECORD_MANIFEST"
        },
        "next_action": {
          "const": "SELECT_VALID_RECORD"
        }
      }
    },
    "record_error__INVALID_STORE_LAYOUT": {
      "properties": {
        "code": {
          "const": "INVALID_STORE_LAYOUT"
        },
        "reason": {
          "const": "INVALID_STORE_LAYOUT"
        },
        "next_action": {
          "const": "SELECT_VALID_STORE"
        }
      }
    },
    "record_error__INSECURE_STORE": {
      "properties": {
        "code": {
          "const": "INSECURE_STORE"
        },
        "reason": {
          "const": "INSECURE_STORE_PERMISSIONS"
        },
        "next_action": {
          "const": "SECURE_STORE"
        }
      }
    },
    "record_error__STORE_NOT_FOUND": {
      "properties": {
        "code": {
          "const": "STORE_NOT_FOUND"
        },
        "reason": {
          "const": "STORE_NOT_FOUND"
        },
        "next_action": {
          "const": "CREATE_OR_SELECT_STORE"
        }
      }
    },
    "record_error__RECORD_NOT_FOUND": {
      "properties": {
        "code": {
          "const": "RECORD_NOT_FOUND"
        },
        "reason": {
          "const": "RECORD_NOT_FOUND"
        },
        "next_action": {
          "const": "SELECT_EXISTING_RECORD"
        }
      }
    },
    "record_error__RECORD_EXISTS": {
      "properties": {
        "code": {
          "const": "RECORD_EXISTS"
        },
        "reason": {
          "const": "RECORD_ALREADY_EXISTS"
        },
        "next_action": {
          "const": "USE_NEW_RECORD_ID"
        }
      }
    },
    "record_error__RECORD_CAPTURE_INCOMPLETE": {
      "properties": {
        "code": {
          "const": "RECORD_CAPTURE_INCOMPLETE"
        },
        "reason": {
          "const": "RECORD_CAPTURE_INCOMPLETE"
        },
        "next_action": {
          "const": "USE_NEW_RECORD_ID"
        }
      }
    },
    "record_error__RECORD_NOT_PUBLISHED": {
      "properties": {
        "code": {
          "const": "RECORD_NOT_PUBLISHED"
        },
        "reason": {
          "const": "RECORD_NOT_PUBLISHED"
        },
        "next_action": {
          "const": "SELECT_PUBLISHED_RECORD"
        }
      }
    },
    "record_error__SOURCE_READ_FAILED": {
      "properties": {
        "code": {
          "const": "SOURCE_READ_FAILED"
        },
        "reason": {
          "const": "SOURCE_READ_FAILED"
        },
        "next_action": {
          "const": "CHECK_SOURCE_FILE"
        }
      }
    },
    "record_error__INPUT_LIMIT_EXCEEDED": {
      "properties": {
        "code": {
          "const": "INPUT_LIMIT_EXCEEDED"
        },
        "reason": {
          "const": "INPUT_LIMIT_EXCEEDED"
        },
        "next_action": {
          "const": "REDUCE_INPUT_SIZE"
        }
      }
    },
    "record_error__RECORD_LIMIT_EXCEEDED": {
      "properties": {
        "code": {
          "const": "RECORD_LIMIT_EXCEEDED"
        },
        "reason": {
          "const": "RECORD_LIMIT_EXCEEDED"
        },
        "next_action": {
          "const": "REDUCE_RECORD_COUNT"
        }
      }
    },
    "record_error__STORE_IO_ERROR": {
      "properties": {
        "code": {
          "const": "STORE_IO_ERROR"
        },
        "reason": {
          "const": "STORE_IO_ERROR"
        },
        "next_action": {
          "const": "CHECK_STORE_IO"
        }
      }
    },
    "record_error__UNSUPPORTED_PLATFORM": {
      "properties": {
        "code": {
          "const": "UNSUPPORTED_PLATFORM"
        },
        "reason": {
          "const": "UNSUPPORTED_PLATFORM"
        },
        "next_action": {
          "const": "USE_SUPPORTED_PLATFORM"
        }
      }
    },
    "record_error__USAGE_ERROR": {
      "properties": {
        "code": {
