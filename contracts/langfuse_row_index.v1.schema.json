{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:underwrite:contract:langfuse_row_index.v1",
  "title": "langfuse_row_index.v1",
  "description": "Content-minimized structural view of two independently selected exports.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_rule_profile",
    "sources",
    "scope",
    "counts",
    "score_rows",
    "verification",
    "limitations",
    "next_actions"
  ],
  "properties": {
    "schema": {
      "const": "langfuse_row_index.v1"
    },
    "source_rule_profile": {
      "const": "langfuse.score-accounting.v1"
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observations",
        "scores"
      ],
      "properties": {
        "observations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format",
            "format_version",
            "raw_hash",
            "claims_verified"
          ],
          "properties": {
            "format": {
              "const": "langfuse.observations-v2"
            },
            "format_version": {
              "const": "4.35.0"
            },
            "raw_hash": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
            },
            "claims_verified": {
              "const": false
            }
          }
        },
        "scores": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format",
            "format_version",
            "raw_hash",
            "claims_verified"
          ],
          "properties": {
            "format": {
              "const": "langfuse.scores"
            },
            "format_version": {
              "const": "4.35.0"
            },
            "raw_hash": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
            },
            "claims_verified": {
              "const": false
            }
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "population",
        "planned_evaluations",
        "export_completeness",
        "selected_file_binding",
        "values"
      ],
      "properties": {
        "population": {
          "const": "supplied_rows"
        },
        "planned_evaluations": {
          "const": "unknown"
        },
        "export_completeness": {
          "const": "unknown"
        },
        "selected_file_binding": {
          "const": "independent_selected_files"
        },
        "values": {
          "const": "withheld"
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observations",
        "scores",
        "by_data_type",
        "associations",
        "observations_without_local_scores"
      ],
      "properties": {
        "observations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 512
        },
        "scores": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2048
        },
        "by_data_type": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "NUMERIC",
            "BOOLEAN",
            "CATEGORICAL",
            "TEXT"
          ],
          "properties": {
            "NUMERIC": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2048
            },
            "BOOLEAN": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2048
            },
            "CATEGORICAL": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2048
            },
            "TEXT": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2048
            }
          }
        },
        "associations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "observation_local",
            "trace_level",
            "unresolved_observation_reference"
          ],
          "properties": {
            "observation_local": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2048
            },
            "trace_level": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2048
            },
            "unresolved_observation_reference": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2048
            }
          }
        },
        "observations_without_local_scores": {
          "type": "integer",
          "minimum": 0,
          "maximum": 512
        }
      }
    },
    "score_rows": {
      "type": "array",
      "maxItems": 2048,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "score_index",
          "data_type",
          "numeric_field_presence",
          "string_field_presence",
          "association",
          "target_observation_index"
        ],
        "properties": {
          "score_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2047
          },
          "data_type": {
            "enum": [
              "NUMERIC",
              "BOOLEAN",
              "CATEGORICAL",
              "TEXT"
            ]
          },
          "numeric_field_presence": {
            "const": "present"
          },
          "string_field_presence": {
            "enum": [
              "present",
              "null"
            ]
          },
          "association": {
            "enum": [
              "observation_local",
              "trace_level",
              "unresolved_observation_reference"
            ]
          },
          "target_observation_index": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 511
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "association": {
                  "const": "observation_local"
                }
              },
              "required": [
                "association"
              ]
            },
            "then": {
              "properties": {
                "target_observation_index": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 511
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "association": {
                  "const": "trace_level"
                }
              },
              "required": [
                "association"
              ]
            },
            "then": {
              "properties": {
                "target_observation_index": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "association": {
                  "const": "unresolved_observation_reference"
                }
              },
              "required": [
                "association"
              ]
            },
            "then": {
              "properties": {
                "target_observation_index": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    },
    "verification": {
      "const": []
    },
    "limitations": {
      "const": [
        "SCORE_CONTENT_WITHHELD",
        "SOURCE_HASHES_AND_ROW_PATTERNS_LINKABLE",
        "SELECTED_FILES_NOT_ATOMICALLY_BOUND",
        "SOURCE_CLAIMS_UNVERIFIED",
        "EXPORT_COMPLETENESS_UNKNOWN",
        "PLANNED_EVALUATIONS_UNKNOWN",
        "NO_TASK_VERDICT_OR_APPROVAL_AUTHORITY"
      ]
    },
    "next_actions": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "enum": [
          "SUPPLY_PLANNED_INVENTORY_FOR_MISSINGNESS",
          "INSPECT_UNRESOLVED_OBSERVATION_REFERENCES"
        ]
      },
      "uniqueItems": true
    }
  }
}
