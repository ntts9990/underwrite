{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:underwrite:contract:goppi_trajectory_review.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "state",
    "policy",
    "input_members",
    "source_context",
    "trust_scope",
    "populations",
    "capture_counts",
    "stages",
    "comparisons",
    "next_verification_tasks",
    "interpretation_limits",
    "authority"
  ],
  "properties": {
    "schema": {
      "const": "goppi_trajectory_review.v1"
    },
    "state": {
      "const": "analyzed"
    },
    "policy": {
      "const": "goppi.descriptive-paired-trajectory.v1"
    },
    "input_members": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "properties": {
          "path": {
            "enum": [
              "paired/execution.json",
              "paired/manifest.json",
              "paired/rows.jsonl",
              "paired/schema.json",
              "trajectory/manifest.json",
              "trajectory/schema.json",
              "trajectory/trajectory.json"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 134217728
          }
        }
      },
      "maxItems": 7
    },
    "source_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cycle_run_id",
        "plan_digest",
        "execution_identity_digest"
      ],
      "properties": {
        "cycle_run_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "plan_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "execution_identity_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "trust_scope": {
      "type": "object",
      "required": [
        "native_verification"
      ],
      "properties": {
        "native_verification": {
          "enum": [
            "not_performed",
            "local_goppi_same_byte_snapshot"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "native_verification": {
                "const": "not_performed"
              }
            }
          },
          "then": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "native_verification",
              "integrity_scope",
              "authenticity",
              "source_authentication_independently_verified",
              "producer_projection_independently_verified",
              "outcome_harness_binding"
            ],
            "properties": {
              "native_verification": {
                "const": "not_performed"
              },
              "integrity_scope": {
                "const": "not_checked"
              },
              "authenticity": {
                "const": "not_checked"
              },
              "source_authentication_independently_verified": {
                "const": false
              },
              "producer_projection_independently_verified": {
                "const": false
              },
              "outcome_harness_binding": {
                "enum": [
                  "v1_not_reverified",
                  "v2_verified_against_patch_manifest",
                  "not_applicable_no_evaluated_stages"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "native_verification": {
                "const": "local_goppi_same_byte_snapshot"
              }
            }
          },
          "then": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "native_verification",
              "integrity_scope",
              "authenticity",
              "source_authentication_independently_verified",
              "producer_projection_independently_verified",
              "outcome_harness_binding"
            ],
            "properties": {
              "native_verification": {
                "const": "local_goppi_same_byte_snapshot"
              },
              "integrity_scope": {
                "const": "self_consistent_content_closure"
              },
              "authenticity": {
                "const": "content_digest_only"
              },
              "source_authentication_independently_verified": {
                "const": false
              },
              "producer_projection_independently_verified": {
                "const": false
              },
              "outcome_harness_binding": {
                "enum": [
                  "v1_not_reverified",
                  "v2_verified_against_patch_manifest",
                  "not_applicable_no_evaluated_stages"
                ]
              }
            }
          }
        }
      ]
    },
    "populations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paired_rows",
        "case_stage_repeat_pairs",
        "unique_source_case_ids",
        "stage_case_slots",
        "primary_repeat_pairs"
      ],
      "properties": {
        "paired_rows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "case_stage_repeat_pairs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "unique_source_case_ids": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "stage_case_slots": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "primary_repeat_pairs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      }
    },
    "capture_counts": {
      "$ref": "#/$defs/coverage"
    },
    "stages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stage"
      },
      "maxItems": 3
    },
    "comparisons": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/comparison"
      },
      "maxItems": 10000
    },
    "next_verification_tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/task"
      },
      "maxItems": 5
    },
    "interpretation_limits": {
      "const": [
        "source_outcomes_are_producer_claims",
        "content_identity_is_not_independent_provenance",
        "source_authentication_and_private_projection_not_independently_verified",
        "tool_frequencies_do_not_align_individual_calls",
        "call_relationships_not_captured",
        "causality_and_retry_effects_not_established",
        "repeated_rows_are_not_independent_cases",
        "metadata_may_identify_sources_not_anonymized",
        "snapshot_checks_do_not_establish_original_directory_privacy"
      ]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "human_review",
        "execution_authorized",
        "merge_authorized",
        "revert_authorized"
      ],
      "properties": {
        "human_review": {
          "const": "required"
        },
        "execution_authorized": {
          "const": false
        },
        "merge_authorized": {
          "const": false
        },
        "revert_authorized": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retained",
        "not_retained",
        "unsupported",
        "interrupted",
        "malformed",
        "storage_failure"
      ],
      "properties": {
        "retained": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "not_retained": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "unsupported": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "interrupted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "malformed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "storage_failure": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      }
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verifier_id",
        "verifier_digest"
      ],
      "properties": {
        "verifier_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "verifier_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "outcome": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "observed",
            "endpoint_failure",
            "missing"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "observed"
              }
            }
          },
          "then": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "value_kind",
              "verifier_value",
              "scored_value"
            ],
            "properties": {
              "status": {
                "const": "observed"
              },
              "value_kind": {
                "enum": [
                  "binary",
                  "scalar"
                ]
              },
              "verifier_value": {},
              "scored_value": {}
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "value_kind": {
                      "const": "binary"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "verifier_value": {
                      "type": "boolean"
                    },
                    "scored_value": {
                      "type": "boolean"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "value_kind": {
                      "const": "scalar"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "verifier_value": {
                      "type": "number"
                    },
                    "scored_value": {
                      "type": "number"
                    }
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "endpoint_failure"
              }
            }
          },
          "then": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "reason",
              "verifier_value",
              "scored_value"
            ],
            "properties": {
              "status": {
                "const": "endpoint_failure"
              },
              "reason": {
                "enum": [
                  "agent_timeout",
                  "agent_budget",
                  "agent_answer"
                ]
              },
              "verifier_value": {
                "type": "null"
              },
              "scored_value": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "missing"
              }
            }
          },
          "then": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "reason",
              "verifier_value",
              "scored_value"
            ],
            "properties": {
              "status": {
                "const": "missing"
              },
              "reason": {
                "enum": [
                  "infra",
                  "verifier_infra",
                  "exhausted_retries",
                  "not_started"
                ]
              },
              "verifier_value": {
                "type": "null"
              },
              "scored_value": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "process": {
      "type": "object",
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "observed",
            "not_observed",
            "unlinked"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "observed"
              }
            }
          },
          "then": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state",
              "attempt_id",
              "receipt_identity_digest",
              "expected_public_identity_digest"
            ],
            "properties": {
              "state": {
                "const": "observed"
              },
              "attempt_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "receipt_identity_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "expected_public_identity_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "not_observed"
              }
            }
          },
          "then": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state"
            ],
            "properties": {
              "state": {
                "const": "not_observed"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "unlinked"
              }
            }
          },
          "then": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state"
            ],
            "properties": {
              "state": {
                "const": "unlinked"
              }
            }
          }
        }
      ]
    },
    "tool_count": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_name",
        "status",
        "count"
      ],
      "properties": {
        "tool_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "status": {
          "enum": [
            "ok",
            "error"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      }
    },
    "side": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_index",
        "evidence_digest",
        "trace_digest",
        "verifier",
        "outcome",
        "primary_inference",
        "repeat_proof",
        "case_pointer",
        "source_availability",
        "capture_completeness",
        "unavailable_reason",
        "llm_span_count",
        "tool_status_counts",
        "context_pointer",
        "verifier_process"
      ],
      "properties": {
        "row_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "evidence_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "trace_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "verifier": {
          "$ref": "#/$defs/verifier"
        },
        "outcome": {
          "$ref": "#/$defs/outcome"
        },
        "primary_inference": {
          "type": "boolean"
        },
        "repeat_proof": {
          "enum": [
            "v1_primary_only",
            "v2_attested_repeat"
          ]
        },
        "case_pointer": {
          "type": "string",
          "pattern": "^/units/[0-9]+/cases/[0-9]+$"
        },
        "source_availability": {
          "enum": [
            "retained",
            "not_retained",
            "unsupported",
            "interrupted",
            "malformed",
            "storage_failure"
          ]
        },
        "capture_completeness": {
          "enum": [
            "complete",
            "incomplete"
          ]
        },
        "unavailable_reason": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "capture_limit_exceeded",
                "capture_policy_unrecorded",
                "recovered_bundle_not_retained",
                "capture_completion_missing",
                "profile_not_supported",
                "pi_lifecycle_interrupted",
                "pi_lifecycle_malformed",
                "receipt_derived_trace",
                "source_storage_write_failed",
                "no_evaluated_outcomes"
              ]
            }
          ]
        },
        "llm_span_count": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            }
          ]
        },
        "tool_status_counts": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/tool_count"
              },
              "maxItems": 10000
            }
          ]
        },
        "context_pointer": {
          "type": "string",
          "pattern": "^/units/[0-9]+/context$"
        },
        "verifier_process": {
          "$ref": "#/$defs/process"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source_availability": {
                "const": "retained"
              }
            }
          },
          "then": {
            "properties": {
              "capture_completeness": {
                "const": "complete"
              },
              "unavailable_reason": {
                "type": "null"
              },
              "llm_span_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              },
              "tool_status_counts": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/tool_count"
                },
                "maxItems": 10000
              }
            }
          },
          "else": {
            "properties": {
              "capture_completeness": {
                "const": "incomplete"
              },
              "unavailable_reason": {
                "enum": [
                  "capture_limit_exceeded",
                  "capture_policy_unrecorded",
                  "recovered_bundle_not_retained",
                  "capture_completion_missing",
                  "profile_not_supported",
                  "pi_lifecycle_interrupted",
                  "pi_lifecycle_malformed",
                  "receipt_derived_trace",
                  "source_storage_write_failed",
                  "no_evaluated_outcomes"
                ]
              },
              "llm_span_count": {
                "type": "null"
              },
              "tool_status_counts": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cycle_run_id",
        "stage_run_id",
        "stage",
        "split",
        "case_id",
        "repeat_run_id",
        "repeat_index"
      ],
      "properties": {
        "cycle_run_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "stage_run_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "stage": {
          "enum": [
            "same_batch",
            "held_in",
            "held_out"
          ]
        },
        "split": {
          "enum": [
            "explore",
            "confirm"
          ]
        },
        "case_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "repeat_run_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "repeat_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        }
      }
    },
    "difference": {
      "type": "object",
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "unavailable",
            "observed"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "unavailable"
              }
            }
          },
          "then": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state",
              "outcome_changed",
              "tool_status_deltas",
              "llm_span_delta"
            ],
            "properties": {
              "state": {
                "const": "unavailable"
              },
              "outcome_changed": {
                "type": "boolean"
              },
              "tool_status_deltas": {
                "type": "null"
              },
              "llm_span_delta": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "observed"
              }
            }
          },
          "then": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state",
              "outcome_changed",
              "llm_span_delta",
              "tool_status_deltas"
            ],
            "properties": {
              "state": {
                "const": "observed"
              },
              "outcome_changed": {
                "type": "boolean"
              },
              "llm_span_delta": {
                "type": "integer",
                "minimum": -10000,
                "maximum": 10000
              },
              "tool_status_deltas": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "tool_name",
                    "status",
                    "candidate_minus_baseline"
                  ],
                  "properties": {
                    "tool_name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "status": {
                      "enum": [
                        "ok",
                        "error"
                      ]
                    },
                    "candidate_minus_baseline": {
                      "type": "integer",
                      "minimum": -10000,
                      "maximum": 10000
                    }
                  }
                },
                "maxItems": 20000
              }
            }
          }
        }
      ]
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "key",
        "baseline",
        "candidate",
        "comparability",
        "difference"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^comparison:[0-9a-f]{64}$"
        },
        "key": {
          "$ref": "#/$defs/key"
        },
        "baseline": {
          "$ref": "#/$defs/side"
        },
        "candidate": {
          "$ref": "#/$defs/side"
        },
        "comparability": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "reasons"
          ],
          "properties": {
            "state": {
              "enum": [
                "comparable",
                "unknown",
                "not_comparable"
              ]
            },
            "reasons": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "field",
                  "reason"
                ],
                "properties": {
                  "field": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "reason": {
                    "enum": [
                      "missing_context",
                      "different_context"
                    ]
                  }
                }
              },
              "maxItems": 64
            }
          }
        },
        "difference": {
          "$ref": "#/$defs/difference"
        }
      }
    },
    "stage": {
      "type": "object",
      "required": [
        "execution_status"
      ],
      "properties": {
        "execution_status": {
          "enum": [
            "evaluated",
            "closed"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "execution_status": {
                "const": "evaluated"
