              "detail_state": {
                "properties": {
                  "analysis_diagnostic": {
                    "const": "intentionally_omitted_use_full_view"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "schema": {
                "const": "trajectory_record_read_summary.v1"
              }
            }
          },
          "then": {
            "allOf": [
              {
                "$ref": "#/$defs/legacy_summary_fields_absent"
