{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:underwrite:contract:deepeval_bound_summary.v1",
  "title": "deepeval_bound_summary.v1",
  "description": "Selected DeepEval metric occurrences and owner-asserted binding counts. No item values, names, coordinates or owner assertion text are returned.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "view",
    "source",
    "declaration_source",
    "processing",
    "population",
    "availability_counts",
    "item_next_action_counts",
    "declared_semantic_binding_counts",
    "verification_entry_count",
    "limitations",
    "detail_state"
  ],
  "properties": {
    "schema": {
      "const": "deepeval_bound_summary.v1"
    },
    "view": {
      "const": "bound-summary"
    },
    "source": {
      "allOf": [
        {
          "description": "Null only when no source identity can be established. Producer version is a declaration or unknown, not authenticated by this contract.",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "format",
            "producer_version",
            "producer_version_state",
            "reader_profile",
            "identity"
          ],
          "properties": {
            "format": {
              "$ref": "#/$defs/token"
            },
            "identity": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "raw_hash"
                  ],
                  "properties": {
                    "kind": {
                      "const": "single_file"
                    },
                    "raw_hash": {
                      "$ref": "#/$defs/hash"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "manifest_raw_hash",
                    "members"
                  ],
                  "properties": {
                    "kind": {
                      "const": "bound_bundle"
                    },
                    "manifest_raw_hash": {
                      "description": "Raw bytes of a bundle manifest. Its hash alone does not establish that member bytes match the manifest, or authenticate the producer.",
                      "$ref": "#/$defs/hash"
                    },
                    "members": {
                      "description": "Each unique role names one member's raw-byte hash. Duplicate JSON keys must be rejected during decoding before schema validation.",
                      "type": "object",
                      "minProperties": 2,
                      "propertyNames": {
                        "$ref": "#/$defs/token"
                      },
                      "additionalProperties": {
                        "$ref": "#/$defs/hash"
                      }
                    }
                  }
                }
              ]
            },
            "producer_version": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/version"
                }
              ],
              "description": "A source-declared package version or null; not authenticated."
            },
            "producer_version_state": {
              "enum": [
                "unknown",
                "declared"
              ]
            },
            "reader_profile": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/token"
                }
              ],
              "description": "Applied local reader rule, not producer version; null if none."
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "producer_version_state": {
                    "const": "declared"
                  }
                },
                "required": [
                  "producer_version_state"
                ]
              },
              "then": {
                "properties": {
                  "producer_version": {
                    "$ref": "#/$defs/version"
                  }
                }
              },
              "else": {
                "properties": {
                  "producer_version": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "format": {
              "const": "deepeval.test-run"
            },
            "identity": {
              "properties": {
                "kind": {
                  "const": "single_file"
                }
              }
            },
            "producer_version_state": {
              "const": "unknown"
            },
            "producer_version": {
              "type": "null"
            }
          }
        }
      ]
    },
    "declaration_source": {
      "allOf": [
        {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "format",
                "raw_hash",
                "authority"
              ],
              "properties": {
                "format": {
                  "$ref": "#/$defs/token"
                },
                "raw_hash": {
                  "$ref": "#/$defs/hash"
                },
                "authority": {
                  "const": "owner_asserted_unverified"
                }
              }
            }
          ],
          "description": "One separately captured owner declaration, if supplied. Its hash identifies bytes but does not authenticate the owner or declared meaning."
        },
        {
          "type": "object",
          "properties": {
            "format": {
              "const": "deepeval_metric_bindings.v2"
            },
            "authority": {
              "const": "owner_asserted_unverified"
            }
          }
        }
      ]
    },
    "processing": {
      "allOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "reason",
            "next_action"
          ],
          "properties": {
            "state": {
              "enum": [
                "analyzed",
                "insufficient",
                "unsupported"
              ]
            },
            "reason": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "enum": [
                    "MISSING_INPUT",
                    "AMBIGUOUS_FORMAT",
                    "UNSUPPORTED_FORMAT",
                    "INVALID_STRUCTURE",
                    "UNBOUND_SOURCE"
                  ]
                }
              ]
            },
            "next_action": {
              "enum": [
                "none",
                "supply_input",
                "select_format",
                "provide_supported_export",
                "repair_export",
                "bind_source"
              ]
            }
          },
          "oneOf": [
            {
              "properties": {
                "state": {
                  "const": "analyzed"
                },
                "reason": {
                  "type": "null"
                },
                "next_action": {
                  "const": "none"
                }
              }
            },
            {
              "properties": {
                "state": {
                  "const": "insufficient"
                },
                "reason": {
                  "const": "MISSING_INPUT"
                },
                "next_action": {
                  "const": "supply_input"
                }
              }
            },
            {
              "properties": {
                "state": {
                  "const": "insufficient"
                },
                "reason": {
                  "const": "AMBIGUOUS_FORMAT"
                },
                "next_action": {
                  "const": "select_format"
                }
              }
            },
            {
              "properties": {
                "state": {
                  "const": "insufficient"
                },
                "reason": {
                  "const": "INVALID_STRUCTURE"
                },
                "next_action": {
                  "const": "repair_export"
                }
              }
            },
            {
              "properties": {
                "state": {
                  "const": "insufficient"
                },
                "reason": {
                  "const": "UNBOUND_SOURCE"
                },
                "next_action": {
                  "const": "bind_source"
                }
              }
            },
            {
              "properties": {
                "state": {
                  "const": "unsupported"
                },
                "reason": {
                  "const": "UNSUPPORTED_FORMAT"
                },
                "next_action": {
                  "const": "provide_supported_export"
                }
              }
            }
          ]
        },
        {
          "properties": {
            "state": {
              "const": "analyzed"
            }
          }
        }
      ]
    },
    "population": {
      "allOf": [
        {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/population"
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "unit": {
              "const": "metric_occurrence"
            },
            "planned_count": {
              "type": "null"
            }
          }
        }
      ]
    },
    "availability_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed",
        "missing",
        "error",
        "abstained",
        "total"
      ],
      "properties": {
        "observed": {
          "type": "integer",
          "minimum": 0
        },
        "missing": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "type": "integer",
          "minimum": 0
        },
        "abstained": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "item_next_action_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "none",
        "inspect_source",
        "supply_plan",
        "supply_applicability",
        "supply_definition",
        "supply_label",
        "rerun_source"
      ],
      "properties": {
        "none": {
          "type": "integer",
          "minimum": 0
        },
        "inspect_source": {
          "type": "integer",
          "minimum": 0
        },
        "supply_plan": {
          "type": "integer",
          "minimum": 0
        },
        "supply_applicability": {
          "type": "integer",
          "minimum": 0
        },
        "supply_definition": {
          "type": "integer",
          "minimum": 0
        },
        "supply_label": {
          "type": "integer",
          "minimum": 0
        },
        "rerun_source": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "declared_semantic_binding_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unbound",
        "bound"
      ],
      "properties": {
        "unbound": {
          "type": "integer",
          "minimum": 0
        },
        "bound": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "verification_entry_count": {
      "type": "integer",
      "minimum": 0
    },
    "limitations": {
      "const": [
        "SOURCE_CLAIMS_UNVERIFIED",
        "OWNER_METRIC_BINDINGS_ASSERTED_UNVERIFIED",
        "SOURCE_BYTES_WITHOUT_EXTERNAL_EXPECTED_HASH",
        "PLANNED_POPULATION_UNKNOWN",
        "ITEM_DETAILS_INTENTIONALLY_OMITTED",
        "VERIFICATION_REFS_NOT_REPERFORMED",
        "NO_MEASUREMENT_OR_APPROVAL_AUTHORITY"
      ]
    },
    "detail_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_values",
        "item_coordinates",
        "metric_names",
        "full_view"
      ],
      "properties": {
        "item_values": {
          "const": "intentionally_omitted"
        },
        "item_coordinates": {
          "const": "intentionally_omitted"
        },
        "metric_names": {
          "const": "intentionally_omitted"
        },
        "full_view": {
          "const": "audit-deepeval --bindings PACK"
        }
      }
    }
  },
  "$defs": {
    "token": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "population": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "observed_count",
        "planned_count"
      ],
      "properties": {
        "unit": {
          "enum": [
            "run",
            "case",
            "row",
            "metric_occurrence"
          ]
        },
        "observed_count": {
          "description": "Number of parsed source records in the declared unit, including records whose outcome is missing or errored. This is not a count of successful measurements.",
          "type": "integer",
          "minimum": 0
        },
        "planned_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    }
  }
}
