        "current_storage_verification": {
          "const": {
            "status": "verified",
            "scope": "stored_bytes_and_direct_links",
            "files_checked": 10,
            "links_checked": 0,
            "findings_count": 0
          }
        },
        "historical_verifier_claim": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 5,
          "properties": {
            "state": {},
            "reported_scope": {}
          },
          "patternProperties": {
            "^(?:verifier_identity_verified|source_authentication_independently_verified|producer_projection_independently_verified)$": {
              "const": false
            }
          },
          "oneOf": [
            {
              "properties": {
                "state": {
                  "const": "not_performed"
                },
                "reported_scope": {
                  "const": "not_performed"
                }
              }
            },
            {
              "properties": {
                "state": {
