{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:underwrite:contract:measurement_semantics.v1",
  "title": "measurement_semantics.v1",
  "description": "Closed representation. Shared pure owners additionally enforce semantic and cross-field invariants.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile",
    "construct",
    "event",
    "unit",
    "sampling_unit",
    "desirable_direction",
    "outcome",
    "prediction",
    "population"
  ],
  "properties": {
    "schema": {
      "const": "measurement_semantics.v1"
    },
    "profile": {
      "const": "binary-event-directional.v1"
    },
    "construct": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "definition"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "definition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "\\S"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "positive_label_definition"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "positive_label_definition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "\\S"
        }
      }
    },
    "unit": {
      "const": "proportion"
    },
    "sampling_unit": {
      "const": "case"
    },
    "desirable_direction": {
      "enum": [
        "higher",
        "lower"
      ]
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instrument",
        "metric_id",
        "label_source",
        "rubric"
      ],
      "properties": {
        "instrument": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "metric_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "label_source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "reference"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "\\S"
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "\\S"
            },
            "reference": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "\\S"
            }
          }
        },
        "rubric": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "reference"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "\\S"
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "\\S"
            },
            "reference": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "\\S"
            }
          }
        }
      }
    },
    "prediction": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "unavailable"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "instrument",
            "metric_id",
            "event_id",
            "timing",
            "reference"
          ],
          "properties": {
            "status": {
              "const": "declared_probability_of_event"
            },
            "instrument": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "\\S"
            },
            "metric_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "\\S"
            },
            "event_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "\\S"
            },
            "timing": {
              "enum": [
                "before_outcome",
                "unknown"
              ]
            },
            "reference": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "\\S"
            }
          }
        }
      ]
    },
    "population": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_id",
        "description"
      ],
      "properties": {
        "frame_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "\\S"
        }
      }
    }
  }
}
