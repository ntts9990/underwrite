{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:underwrite:contract:paired_binary_policy.v1",
  "title": "paired_binary_policy.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "seed",
    "permutation_iterations",
    "bootstrap_iterations",
    "confidence",
    "max_work",
    "assumptions"
  ],
  "properties": {
    "schema": {
      "const": "paired_binary_policy.v1"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "permutation_iterations": {
      "type": "integer",
      "minimum": 10000,
      "maximum": 20000
    },
    "bootstrap_iterations": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 10000
    },
    "confidence": {
      "type": "number",
      "exclusiveMinimum": 0,
      "exclusiveMaximum": 1
    },
    "max_work": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2000000
    },
    "assumptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "independent_units",
        "sign_flip_invariance",
        "fixed_sample"
      ],
      "properties": {
        "independent_units": {
          "type": "boolean"
        },
        "sign_flip_invariance": {
          "type": "boolean"
        },
        "fixed_sample": {
          "type": "boolean"
        }
      }
    }
  }
}
