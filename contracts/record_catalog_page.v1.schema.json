{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:underwrite:contract:record_catalog_page.v1",
  "title": "record_catalog_page.v1",
  "description": "One bounded observation of a local record catalog. Continuations bind to the observed digest; this is neither a transactional snapshot nor file verification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "view",
    "catalog_state",
    "catalog_digest",
    "record_count",
    "offset",
    "page_size",
    "records",
    "next_page",
    "restart_offset",
    "next_action",
    "verification_scope",
    "limitations",
    "detail_state"
  ],
  "properties": {
    "schema": {
      "const": "record_catalog_page.v1"
    },
    "view": {
      "const": "page"
    },
    "catalog_state": {
      "enum": [
        "observed",
        "changed"
      ]
    },
    "catalog_digest": {
      "$ref": "#/$defs/digest"
    },
    "record_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000,
      "multipleOf": 50
    },
    "page_size": {
      "const": 50
    },
    "records": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/complete"
          },
          {
            "$ref": "#/$defs/unpublished"
          }
        ]
      },
      "uniqueItems": true
    },
    "next_page": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "offset"
          ],
          "properties": {
            "offset": {
              "type": "integer",
              "minimum": 50,
              "maximum": 1000,
              "multipleOf": 50
            }
          }
        }
      ]
    },
    "restart_offset": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "const": 0
        }
      ]
    },
    "next_action": {
      "enum": [
        "FOLLOW_NEXT_PAGE_OR_SELECT_ID",
        "SELECT_ID_OR_FINISH",
        "NO_RECORDS",
        "RESTART_FROM_FIRST_PAGE"
      ]
    },
    "verification_scope": {
      "const": "catalog_metadata_only"
    },
    "limitations": {
      "const": [
        "FILES_NOT_VERIFIED",
        "SOURCE_PROVENANCE_NOT_ESTABLISHED",
        "CATALOG_NOT_ATOMIC_SNAPSHOT"
      ]
    },
    "detail_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "labels",
        "captured_at",
        "full_view"
      ],
      "properties": {
        "labels": {
          "const": "intentionally_omitted"
        },
        "captured_at": {
          "const": "intentionally_omitted"
        },
        "full_view": {
          "const": "records list --view full"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "catalog_state": {
            "const": "changed"
          }
        }
      },
      "then": {
        "properties": {
          "records": {
            "maxItems": 0
          },
          "next_page": {
            "type": "null"
          },
          "restart_offset": {
            "const": 0
          },
          "next_action": {
            "const": "RESTART_FROM_FIRST_PAGE"
          }
        }
      },
      "else": {
        "properties": {
          "restart_offset": {
            "type": "null"
          },
          "next_action": {
            "enum": [
              "FOLLOW_NEXT_PAGE_OR_SELECT_ID",
              "SELECT_ID_OR_FINISH",
              "NO_RECORDS"
            ]
