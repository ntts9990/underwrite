{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:underwrite:contract:gate_rules.v1",
  "title": "gate_rules.v1",
  "description": "Declarative gate-rule conditions and decision labels. The loader checks structure, types, ranges, unique rule ids and canonical decimal bounds only. Labels are uninterpreted declarations: loading a rule grants no approval, adoption or deployment authority. Rule order carries no evaluation meaning and no evaluator is implemented here. Unmatched input is declared Hold; not_measured and indeterminate have no matchable predicate values.",
  "type": "object",
  "required": [
    "schema",
    "default",
    "rules"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "gate_rules.v1"
    },
    "default": {
      "type": "object",
      "description": "Required structural label for an unmatched situation, fixed to Hold. No evaluator applies it here.",
      "required": [
        "decision"
      ],
      "additionalProperties": false,
      "properties": {
        "decision": {
          "const": "Hold"
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "priority",
        "when",
        "decision"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}(?![\\s\\S])"
        },
        "kind": {
          "type": "string",
          "enum": [
            "hard_gate",
            "optimization_metric"
          ],
          "description": "membership: a hard gate or an optimization metric; their order is the evaluator's."
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000,
          "description": "Explicit, never taken from list order. Its direction and tie handling are the evaluator's."
        },
        "when": {
          "$ref": "#/$defs/condition"
        },
        "decision": {
          "type": "string",
          "enum": [
            "Approve",
            "Conditional",
            "Shadow",
            "HITL-only",
            "Hold",
            "Reject",
            "Rollback"
          ],
          "description": "Uninterpreted decision label associated with this condition cell. Loading it neither permits nor issues a decision."
        }
      }
    },
    "condition": {
      "type": "object",
      "description": "Exactly one of all (every predicate holds) or any (at least one holds).",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "all": {
          "$ref": "#/$defs/predicates"
        },
        "any": {
          "$ref": "#/$defs/predicates"
        }
      }
    },
    "predicates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/predicate"
      }
    },
    "predicate": {
      "type": "object",
      "description": "Exactly one closed single-key predicate. The four metric names are decision_rule's.",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "read_verdict": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "pass",
              "warn",
              "fail"
            ]
          },
          "maxItems": 3,
          "uniqueItems": true
        },
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "screened",
              "confirmed",
              "rejected"
            ]
          },
          "maxItems": 3,
          "uniqueItems": true
        },
        "bootstrap_ci_lower": {
          "$ref": "#/$defs/bounds"
        },
        "bootstrap_ci_upper": {
          "$ref": "#/$defs/bounds"
        },
        "cohens_d": {
          "$ref": "#/$defs/bounds"
        },
        "failure_rate_current": {
          "$ref": "#/$defs/bounds"
        }
      }
    },
    "bounds": {
      "type": "object",
      "description": "Inclusive bounds, as decision.py. Whether min <= max is checked by the loader.",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "min": {
          "$ref": "#/$defs/decimal"
        },
        "max": {
          "$ref": "#/$defs/decimal"
        }
      }
    },
    "decimal": {
      "type": "string",
      "description": "A threshold as its one canonical decimal spelling: no -0, no leading or trailing zeros, no exponent, sign only for negatives. Compared exactly, never as a float.",
      "pattern": "^(?!-0(?![\\s\\S]))-?(0|[1-9][0-9]{0,15})(\\.[0-9]{0,14}[1-9])?(?![\\s\\S])"
    }
  }
}
