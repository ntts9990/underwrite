{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:underwrite:contract:release_inspection.v1",
  "title": "release_inspection.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "manifest_hash",
    "scope",
    "result",
    "subject",
    "requirements",
    "evidence",
    "limitations"
  ],
  "properties": {
    "schema": {
      "const": "release_inspection.v1"
    },
    "manifest_hash": {
      "$ref": "#/$defs/hash"
    },
    "scope": {
      "const": "declared_release_linkage"
    },
    "result": {
      "enum": [
        "requirements_matched",
        "gaps_found"
      ]
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "result",
          "evidence_ids",
          "diagnostics"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "result": {
            "enum": [
              "matched",
              "unresolved"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "$ref": "#/$defs/id"
            },
            "uniqueItems": true
          },
          "diagnostics": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/diagnostic"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "enum": [
          "SOURCE_CLAIMS_UNVERIFIED",
          "RELEASE_AUTHENTICITY_UNVERIFIED",
          "RUN_INDEPENDENCE_UNVERIFIED",
          "CONTENT_ADEQUACY_NOT_ASSESSED",
          "MEASUREMENT_NOT_PERFORMED",
          "NO_DEPLOYMENT_DECISION"
        ]
      },
      "uniqueItems": true
    }
  },
  "$comment": "Shape validation alone does not establish acceptance: validate_release_report also checks references, state precedence, diagnostics and membership/result equivalence.",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}(?![\\s\\S])"
    },
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?=[\\s\\S]*[^\\s])[^\\u0000-\\u001f\\u007f-\\u009f\\ud800-\\udfff]+(?![\\s\\S])",
      "$comment": "NFC is enforced by the application semantic validator."
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "version",
        "environment",
        "evalset",
        "evalset_version",
        "conditions"
      ],
      "properties": {
        "target": {
          "$ref": "#/$defs/identity"
        },
        "version": {
          "$ref": "#/$defs/identity"
        },
        "environment": {
          "$ref": "#/$defs/identity"
        },
        "evalset": {
          "$ref": "#/$defs/identity"
        },
        "evalset_version": {
          "$ref": "#/$defs/identity"
        },
        "conditions": {
          "$ref": "#/$defs/identity"
        }
      }
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_hash",
        "observation",
        "expected_hash_check",
        "projection"
      ],
      "properties": {
        "raw_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/hash"
            },
            {
              "type": "null"
            }
          ]
        },
        "observation": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "digest"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "digest": {
                  "$ref": "#/$defs/hash"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "expected_hash_check": {
          "enum": [
            "not_checked",
            "not_supplied",
            "matched",
            "mismatched"
          ]
        },
        "projection": {
          "enum": [
            "created",
            "not_created"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "raw_hash": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "expected_hash_check": {
                "const": "not_checked"
              },
              "observation": {
                "type": "null"
              },
              "projection": {
                "const": "not_created"
              }
            }
          },
          "else": {
            "properties": {
              "expected_hash_check": {
                "enum": [
                  "not_supplied",
                  "matched",
                  "mismatched"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "projection": {
                "const": "created"
              }
            }
          },
          "then": {
            "properties": {
              "observation": {
                "type": "object"
              },
              "raw_hash": {
                "$ref": "#/$defs/hash"
              },
              "expected_hash_check": {
                "enum": [
                  "not_supplied",
                  "matched"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "observation": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverage",
        "origin",
        "state",
        "source_value",
        "declared_value"
      ],
      "properties": {
        "coverage": {
          "enum": [
            "unavailable",
            "unmapped",
            "absent",
            "complete",
            "partial",
            "unusable"
          ]
        },
        "origin": {
          "enum": [
            "source_present",
            "declared",
            "unknown"
          ]
        },
        "state": {
          "enum": [
            "matched",
            "mismatched",
            "unknown",
            "ambiguous",
            "conflict"
          ]
        },
        "source_value": {
          "anyOf": [
            {
              "$ref": "#/$defs/identity"
            },
            {
              "type": "null"
            }
          ]
        },
        "declared_value": {
          "anyOf": [
            {
              "$ref": "#/$defs/identity"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "coverage": {
                "const": "unavailable"
              }
            }
          },
          "then": {
            "properties": {
              "origin": {
                "const": "unknown"
              },
              "state": {
                "enum": [
                  "unknown",
                  "mismatched"
                ]
              },
              "source_value": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "coverage": {
                "const": "unmapped"
              }
            }
          },
          "then": {
            "properties": {
              "origin": {
                "enum": [
                  "declared",
                  "unknown"
                ]
              },
              "source_value": {
                "type": "null"
              },
              "state": {
                "enum": [
                  "matched",
                  "mismatched",
                  "unknown"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "coverage": {
                "const": "absent"
              }
            }
          },
          "then": {
            "properties": {
              "origin": {
                "enum": [
                  "declared",
                  "unknown"
                ]
              },
              "source_value": {
                "type": "null"
              },
              "state": {
                "enum": [
                  "matched",
                  "mismatched",
                  "unknown"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "coverage": {
                "const": "complete"
              }
            }
          },
          "then": {
            "properties": {
              "origin": {
                "const": "source_present"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "coverage": {
                "const": "partial"
              }
            }
          },
          "then": {
            "properties": {
              "origin": {
                "const": "source_present"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "coverage": {
                "const": "unusable"
              }
            }
          },
          "then": {
            "properties": {
              "origin": {
                "enum": [
                  "source_present",
                  "unknown"
                ]
              },
              "state": {
                "enum": [
                  "unknown",
                  "mismatched",
                  "ambiguous",
                  "conflict"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "coverage": {
                "const": "partial"
              }
            }
          },
          "then": {
            "properties": {
              "state": {
                "enum": [
                  "unknown",
                  "mismatched",
                  "ambiguous",
                  "conflict"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "origin": {
                "const": "declared"
              }
            }
          },
          "then": {
            "properties": {
              "coverage": {
                "enum": [
                  "unmapped",
                  "absent"
                ]
              },
              "declared_value": {
                "$ref": "#/$defs/identity"
              },
              "source_value": {
                "type": "null"
              },
              "state": {
                "enum": [
                  "matched",
                  "mismatched"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "origin": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "source_value": {
                "type": "null"
              },
              "state": {
                "enum": [
                  "unknown",
                  "mismatched"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "origin": {
                "const": "source_present"
              }
            }
          },
          "then": {
            "properties": {
              "coverage": {
                "enum": [
                  "complete",
                  "partial",
                  "unusable"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "ambiguous"
              }
            }
          },
          "then": {
            "properties": {
              "source_value": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "coverage": {
                "enum": [
                  "unmapped",
                  "absent"
                ]
              },
              "declared_value": {
                "type": "string"
              }
            }
          },
          "then": {
            "properties": {
              "origin": {
                "const": "declared"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "coverage": {
                "enum": [
                  "unmapped",
                  "absent"
                ]
              },
              "declared_value": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "origin": {
                "const": "unknown"
              },
              "state": {
                "const": "unknown"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "origin": {
                "const": "source_present"
              },
              "state": {
                "enum": [
                  "matched",
                  "mismatched",
                  "unknown"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "source_value": {
                "$ref": "#/$defs/identity"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "conflict"
              }
            }
          },
          "then": {
            "properties": {
              "declared_value": {
                "$ref": "#/$defs/identity"
              },
              "origin": {
                "const": "source_present"
              }
            }
          }
        }
      ]
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "location",
        "field",
        "source_path",
        "next_action"
      ],
      "properties": {
        "code": {
          "enum": [
            "MISSING_EVIDENCE",
            "UNRESOLVED_REQUIREMENT",
            "UNSUPPORTED_LINKAGE_PROFILE",
            "UNSUPPORTED_FORMAT",
            "EMPTY_EVIDENCE",
            "IDENTITY_UNKNOWN",
            "IDENTITY_MISMATCH",
            "IDENTITY_CONFLICT",
            "IDENTITY_AMBIGUOUS",
            "SOURCE_IDENTITY_UNUSABLE",
            "SELECTOR_MISMATCH",
            "AMBIGUOUS_EVIDENCE",
            "DUPLICATE_EVIDENCE",
            "INVALID_JSON_INPUT",
            "DUPLICATE_JSON_KEY",
            "NON_FINITE_JSON_NUMBER",
            "DEPTH_LIMIT_EXCEEDED",
            "SOURCE_READ_FAILED",
            "SOURCE_NOT_REGULAR_FILE",
            "SOURCE_NONBLOCKING_UNAVAILABLE",
            "INVALID_PROJECTION",
            "NON_STRING_KEY",
            "NFC_KEY_COLLISION",
            "INVALID_OBSERVATION",
            "MALFORMED_EVIDENCE_BUNDLE_PAYLOAD",
            "MALFORMED_DEEPEVAL_PAYLOAD",
            "MALFORMED_INSPECT_PAYLOAD",
            "MALFORMED_LANGFUSE_PAYLOAD",
            "MALFORMED_OPENINFERENCE_PAYLOAD",
            "MALFORMED_OTLP_JSON_PAYLOAD",
            "MALFORMED_PROMPTFOO_PAYLOAD",
            "INT_OUT_OF_SAFE_RANGE",
            "EXPECTED_HASH_MISMATCH"
          ]
        },
        "location": {
          "type": "string",
          "pattern": "^/(?:requirements/(?:0|[1-9][0-9]*)|evidence/(?:0|[1-9][0-9]*)(?:/case/(?:artifact(?:/(?:path|expected_hash))?|source(?:/(?:format|format_version|ref|locator))?))?)(?![\\s\\S])"
        },
        "field": {
          "enum": [
            "target",
            "version",
            "environment",
            "evalset",
            "evalset_version",
            "conditions",
            null
          ]
        },
        "source_path": {
          "enum": [
            "/observations/*/release",
            "/observations/*/environment",
            null
          ]
        },
        "next_action": {
          "enum": [
            "PROVIDE_REQUIRED_EVIDENCE",
            "CORRECT_MANIFEST",
            "SELECT_SUPPORTED_PROFILE",
            "PROVIDE_NONEMPTY_EVIDENCE",
            "PROVIDE_BINDING_METADATA",
            "CHECK_BINDING_METADATA",
            "SELECT_REQUIRED_PROFILE",
            "SELECT_ONE_EVIDENCE",
            "REMOVE_DUPLICATE_REFERENCE",
            "CHECK_EXPECTED_HASH",
            "CORRECT_ARTIFACT",
            "PROVIDE_REGULAR_LOCAL_FILE"
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "requirement",
        "location",
        "artifact",
        "record_presence",
        "bindings",
        "diagnostics"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "requirement": {
          "$ref": "#/$defs/id"
        },
        "location": {
          "type": "string",
          "pattern": "^/evidence/(?:0|[1-9][0-9]*)(?![\\s\\S])"
        },
        "artifact": {
          "$ref": "#/$defs/artifact"
        },
        "record_presence": {
          "enum": [
            "present",
            "empty",
            "unknown"
          ]
        },
        "bindings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "target",
            "version",
            "environment",
            "evalset",
            "evalset_version",
            "conditions"
          ],
          "properties": {
            "target": {
              "$ref": "#/$defs/binding"
            },
            "version": {
              "$ref": "#/$defs/binding"
            },
            "environment": {
              "$ref": "#/$defs/binding"
            },
            "evalset": {
              "$ref": "#/$defs/binding"
            },
            "evalset_version": {
              "$ref": "#/$defs/binding"
            },
            "conditions": {
              "$ref": "#/$defs/binding"
            }
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "artifact": {
                "properties": {
                  "projection": {
                    "const": "not_created"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "record_presence": {
                "const": "unknown"
              }
            }
          }
        }
      ]
    }
  }
}
