{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:underwrite:contract:cross_artifact_review_summary.v1",
  "title": "cross_artifact_review_summary.v1",
  "description": "Bounded source-claim alignment; per-pair coordinates and source-declared strings are omitted. No equivalence, improvement or approval is established.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "view",
    "relation",
    "source_identity",
    "readers",
    "populations",
    "correspondence",
    "finding_counts",
    "improvement",
    "checks",
    "next_verification_tasks",
    "limitations",
    "detail_state"
  ],
  "properties": {
    "schema": {
      "const": "cross_artifact_review_summary.v1"
    },
    "view": {
      "const": "summary"
    },
    "relation": {
      "enum": [
        "incomparable_on_supplied_evidence",
        "declared_case_mapping_descriptive"
      ]
    },
    "source_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goppi_assessment_sha256",
        "goppi_result_sha256",
        "promptfoo_export_sha256"
      ],
      "properties": {
        "goppi_assessment_sha256": {
          "$ref": "#/$defs/hash"
        },
        "goppi_result_sha256": {
          "$ref": "#/$defs/hash"
        },
        "promptfoo_export_sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "finding_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "equal",
        "different",
        "ineligible"
      ],
      "properties": {
        "equal": {
          "type": "integer",
          "minimum": 0
        },
        "different": {
          "type": "integer",
          "minimum": 0
        },
        "ineligible": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "improvement": {
      "const": "unknown"
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declaration_source_hashes",
        "goppi_assessment_result_binding",
        "goppi_terminal_controls",
        "goppi_portable_closure",
        "source_authentication"
      ],
      "properties": {
        "declaration_source_hashes": {
          "enum": [
            "matched",
            "not_supplied"
          ]
        },
        "goppi_assessment_result_binding": {
          "const": "checked_selected_fields"
        },
        "goppi_terminal_controls": {
          "const": "not_reperformed"
        },
        "goppi_portable_closure": {
          "const": "not_reperformed"
        },
        "source_authentication": {
          "const": "not_independently_verified"
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "enum": [
          "SOURCE_CLAIMS_UNVERIFIED",
          "GOPPI_PORTABLE_CLOSURE_NOT_REPERFORMED",
          "GOPPI_TERMINAL_CONTROLS_NOT_REPERFORMED",
          "INPUT_CORRESPONDENCE_NOT_INDEPENDENTLY_VERIFIED",
          "SEMANTIC_EQUIVALENCE_UNESTABLISHED",
          "PROMPTFOO_PLANNED_POPULATION_UNKNOWN",
          "PROMPTFOO_ROW_ROLES_SOURCE_DECLARED",
          "HASHES_AND_COORDINATES_MAY_IDENTIFY_SOURCES",
          "NO_IMPROVEMENT_OR_APPROVAL"
        ]
      },
      "uniqueItems": true
    },
    "readers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goppi",
        "promptfoo"
      ],
      "properties": {
        "goppi": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "assessment_schema",
            "result_schema"
          ],
          "properties": {
            "profile": {
              "const": "goppi.c55-selected-fields.v1"
            },
            "assessment_schema": {
              "const": "goppi.operator_answer_exchange_assessment.v1"
            },
            "result_schema": {
              "const": "evidence_result.v1"
            }
          }
        },
        "promptfoo": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "producer_version_state"
          ],
          "properties": {
            "profile": {
              "const": "promptfoo.summary-v3.selected-fields.v1"
            },
            "producer_version_state": {
              "enum": [
                "unknown",
                "declared"
              ]
            }
          }
        }
      }
    },
    "populations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goppi",
        "promptfoo"
      ],
      "properties": {
        "goppi": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unit",
            "planned_count",
            "item_count",
            "availability"
          ],
          "properties": {
            "unit": {
              "const": "case"
            },
            "planned_count": {
              "type": "integer",
              "minimum": 0
            },
            "item_count": {
              "type": "integer",
              "minimum": 0
            },
            "availability": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "observed",
                "missing",
                "error",
                "abstained"
              ],
              "properties": {
                "observed": {
                  "type": "integer",
                  "minimum": 0
                },
                "missing": {
                  "type": "integer",
                  "minimum": 0
                },
                "error": {
                  "type": "integer",
                  "minimum": 0
                },
                "abstained": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        },
        "promptfoo": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unit",
            "supplied_rows",
            "subject_rows",
            "control_rows",
            "planned_count",
            "category_counts"
          ],
          "properties": {
            "unit": {
              "const": "row"
            },
            "supplied_rows": {
              "type": "integer",
              "minimum": 0
            },
            "subject_rows": {
              "type": "integer",
              "minimum": 0
            },
            "control_rows": {
              "type": "integer",
              "minimum": 0
            },
            "planned_count": {
              "type": "null"
            },
            "category_counts": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "successes",
                "failures",
                "errors"
              ],
              "properties": {
                "successes": {
                  "type": "integer",
                  "minimum": 0
                },
                "failures": {
                  "type": "integer",
                  "minimum": 0
                },
                "errors": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "correspondence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declaration_sha256",
        "coverage",
        "input_correspondence",
        "semantic_equivalence",
        "condition_alignment",
        "unmatched_case_count",
        "unmatched_subject_row_count"
      ],
      "properties": {
        "declaration_sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/hash"
            }
          ]
        },
        "coverage": {
          "enum": [
            "none",
            "complete",
            "partial"
          ]
        },
        "input_correspondence": {
          "enum": [
            "not_declared",
            "declared_unverified"
          ]
        },
        "semantic_equivalence": {
          "const": "unestablished"
        },
        "condition_alignment": {
          "const": "not_established"
        },
        "unmatched_case_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "unmatched_subject_row_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      }
    },
    "next_verification_tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "owner",
          "count"
        ],
        "properties": {
          "code": {
            "enum": [
              "PROVIDE_SOURCE_BOUND_CASE_CORRESPONDENCE",
              "PROVIDE_PROMPTFOO_SUBJECT_ROWS",
              "PROVIDE_MATCHING_SOURCE_CASE_IDS",
              "DECLARE_REMAINING_CASE_CORRESPONDENCE",
              "VERIFY_INPUT_AND_METRIC_SEMANTICS",
              "VERIFY_GOPPI_PORTABLE_CLOSURE",
              "VERIFY_SOURCE_PROVENANCE",
              "PROVIDE_COMPARATOR_CONDITIONS",
              "INSPECT_INELIGIBLE_CASE_EVIDENCE"
            ]
          },
          "owner": {
            "enum": [
              "evaluation_owner",
              "source_reviewer",
              "calling_agent"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        },
        "oneOf": [
          {
            "properties": {
              "code": {
                "const": "PROVIDE_SOURCE_BOUND_CASE_CORRESPONDENCE"
              },
              "owner": {
                "const": "evaluation_owner"
              }
            }
          },
          {
            "properties": {
              "code": {
                "const": "PROVIDE_PROMPTFOO_SUBJECT_ROWS"
              },
              "owner": {
                "const": "evaluation_owner"
              }
            }
          },
          {
            "properties": {
              "code": {
                "const": "PROVIDE_MATCHING_SOURCE_CASE_IDS"
              },
              "owner": {
                "const": "evaluation_owner"
              }
            }
          },
          {
            "properties": {
              "code": {
                "const": "DECLARE_REMAINING_CASE_CORRESPONDENCE"
              },
              "owner": {
                "const": "evaluation_owner"
              }
            }
          },
          {
            "properties": {
              "code": {
                "const": "VERIFY_INPUT_AND_METRIC_SEMANTICS"
              },
              "owner": {
                "const": "evaluation_owner"
              }
            }
          },
          {
            "properties": {
              "code": {
                "const": "VERIFY_GOPPI_PORTABLE_CLOSURE"
              },
              "owner": {
                "const": "source_reviewer"
              }
            }
          },
          {
            "properties": {
              "code": {
                "const": "VERIFY_SOURCE_PROVENANCE"
              },
              "owner": {
                "const": "source_reviewer"
              }
            }
          },
          {
            "properties": {
              "code": {
                "const": "PROVIDE_COMPARATOR_CONDITIONS"
              },
              "owner": {
                "const": "evaluation_owner"
              }
            }
          },
          {
            "properties": {
              "code": {
                "const": "INSPECT_INELIGIBLE_CASE_EVIDENCE"
              },
              "owner": {
                "const": "calling_agent"
              }
            }
          }
        ]
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "code": {
                "const": "PROVIDE_SOURCE_BOUND_CASE_CORRESPONDENCE"
              }
            }
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "code": {
                "const": "PROVIDE_PROMPTFOO_SUBJECT_ROWS"
              }
            }
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "code": {
                "const": "PROVIDE_MATCHING_SOURCE_CASE_IDS"
              }
            }
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "code": {
                "const": "DECLARE_REMAINING_CASE_CORRESPONDENCE"
              }
            }
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "code": {
                "const": "VERIFY_INPUT_AND_METRIC_SEMANTICS"
              }
            }
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "code": {
                "const": "VERIFY_GOPPI_PORTABLE_CLOSURE"
              }
            }
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "code": {
                "const": "VERIFY_SOURCE_PROVENANCE"
              }
            }
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "code": {
                "const": "PROVIDE_COMPARATOR_CONDITIONS"
              }
            }
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "code": {
                "const": "INSPECT_INELIGIBLE_CASE_EVIDENCE"
              }
            }
          },
          "minContains": 0,
          "maxContains": 1
        }
      ]
    },
    "detail_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pair_details",
        "unmatched_coordinates",
        "task_coordinates",
        "producer_version",
        "full_view"
      ],
      "properties": {
        "pair_details": {
          "const": "intentionally_omitted"
        },
        "unmatched_coordinates": {
          "const": "intentionally_omitted"
        },
        "task_coordinates": {
          "const": "intentionally_omitted"
        },
        "producer_version": {
          "enum": [
            "intentionally_omitted",
            "not_applicable"
          ]
        },
        "full_view": {
          "const": "review-artifacts --view review"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "relation": {
            "const": "incomparable_on_supplied_evidence"
          }
        }
      },
      "then": {
        "properties": {
          "correspondence": {
            "properties": {
              "declaration_sha256": {
                "type": "null"
              },
              "coverage": {
                "const": "none"
              },
              "input_correspondence": {
                "const": "not_declared"
              }
            }
          },
          "checks": {
            "properties": {
              "declaration_source_hashes": {
                "const": "not_supplied"
              }
            }
          },
          "finding_counts": {
            "properties": {
              "equal": {
                "const": 0
              },
              "different": {
                "const": 0
              },
              "ineligible": {
                "const": 0
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "correspondence": {
            "properties": {
              "declaration_sha256": {
                "$ref": "#/$defs/hash"
              },
              "coverage": {
                "enum": [
                  "complete",
                  "partial"
                ]
              },
              "input_correspondence": {
                "const": "declared_unverified"
              }
            }
          },
          "checks": {
            "properties": {
              "declaration_source_hashes": {
                "const": "matched"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "relation": {
            "const": "incomparable_on_supplied_evidence"
          },
          "populations": {
            "properties": {
              "promptfoo": {
                "properties": {
                  "subject_rows": {
                    "const": 0
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "next_verification_tasks": {
            "contains": {
              "properties": {
                "code": {
                  "const": "PROVIDE_PROMPTFOO_SUBJECT_ROWS"
                },
                "owner": {
                  "const": "evaluation_owner"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "readers": {
            "properties": {
              "promptfoo": {
                "properties": {
                  "producer_version_state": {
                    "const": "unknown"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "detail_state": {
            "properties": {
              "producer_version": {
                "const": "not_applicable"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "detail_state": {
            "properties": {
              "producer_version": {
                "const": "intentionally_omitted"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
