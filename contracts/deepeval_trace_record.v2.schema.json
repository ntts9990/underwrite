{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:underwrite:contract:deepeval_trace_record.v2",
  "title": "deepeval_trace_record.v2",
  "description": "Independent selected DeepEval analysis and private capture outcomes. A saved record verifies bytes, not producer execution or approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "command",
    "source",
    "analysis",
    "storage",
    "exit_code"
  ],
  "properties": {
    "schema": {
      "const": "deepeval_trace_record.v2"
    },
    "command": {
      "const": "records audit-deepeval"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "analysis": {
      "$ref": "#/$defs/analysis"
    },
    "storage": {
      "$ref": "#/$defs/storage"
    },
    "exit_code": {
      "enum": [
        0,
        2,
        3
      ]
    }
  },
  "$defs": {
    "deepeval_trace_index": {
      "title": "deepeval_trace_index.v2",
      "description": "Selected DeepEval case and span structure; producer version unknown.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "source",
        "raw_hash",
        "rule_profile",
        "scope",
        "cases",
        "counts",
        "limitations",
        "next_actions",
        "reader_profile"
      ],
      "properties": {
        "schema": {
          "const": "deepeval_trace_index.v2"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format",
            "producer_version",
            "producer_version_state",
            "claims_verified"
          ],
          "properties": {
            "format": {
              "const": "deepeval.test-run"
            },
            "producer_version": {
              "type": "null"
            },
            "producer_version_state": {
              "const": "unknown"
            },
            "claims_verified": {
              "const": false
            }
          }
        },
        "raw_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
        },
        "rule_profile": {
          "const": "deepeval.trace-index.v1"
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unit",
            "case_roster",
            "selected_fields_only",
            "planned_steps",
            "instrumentation_completeness",
            "source_claims_verified",
            "expectations",
            "dataset_version"
          ],
          "properties": {
            "unit": {
              "const": "observed_span"
            },
            "case_roster": {
              "const": "supplied_test_cases"
            },
            "selected_fields_only": {
              "const": true
            },
            "planned_steps": {
              "const": "unknown"
            },
            "instrumentation_completeness": {
              "const": "unknown"
            },
            "source_claims_verified": {
              "const": false
            },
            "expectations": {
              "const": "not_analyzed"
            },
            "dataset_version": {
              "const": "not_analyzed"
            }
          }
        },
        "cases": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "case_index",
              "pointer",
              "source_success",
              "trace_availability",
              "trace_status",
              "groups",
              "spans"
            ],
            "properties": {
              "case_index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 511
              },
              "pointer": {
                "type": "string",
                "pattern": "^/testCases/(0|[1-9][0-9]*)(?![\\s\\S])"
              },
              "source_success": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "trace_availability": {
                "enum": [
                  "absent",
                  "null",
                  "present"
                ]
              },
              "trace_status": {
                "enum": [
                  "SUCCESS",
                  "ERRORED",
                  null
                ]
              },
              "groups": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "baseSpans",
                  "agentSpans",
                  "llmSpans",
                  "retrieverSpans",
                  "toolSpans"
                ],
                "properties": {
                  "baseSpans": {
                    "enum": [
                      "absent",
                      "null",
                      "empty",
                      "present"
                    ]
                  },
                  "agentSpans": {
                    "enum": [
                      "absent",
                      "null",
                      "empty",
                      "present"
                    ]
                  },
                  "llmSpans": {
                    "enum": [
                      "absent",
                      "null",
                      "empty",
                      "present"
                    ]
                  },
                  "retrieverSpans": {
                    "enum": [
                      "absent",
                      "null",
                      "empty",
                      "present"
                    ]
                  },
                  "toolSpans": {
                    "enum": [
                      "absent",
                      "null",
                      "empty",
                      "present"
                    ]
                  }
                }
              },
              "spans": {
                "type": "array",
                "maxItems": 1024,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "span_index",
                    "pointer",
                    "group",
                    "group_index",
                    "declared_type",
                    "source_status",
                    "parent_state",
                    "parent_pointer",
                    "cycle_member",
                    "group_type_mismatch"
                  ],
                  "properties": {
                    "span_index": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1023
                    },
                    "pointer": {
                      "type": "string",
                      "pattern": "^/testCases/(0|[1-9][0-9]*)/trace/(baseSpans|agentSpans|llmSpans|retrieverSpans|toolSpans)/(0|[1-9][0-9]*)(?![\\s\\S])"
                    },
                    "group": {
                      "enum": [
                        "baseSpans",
                        "agentSpans",
                        "llmSpans",
                        "retrieverSpans",
                        "toolSpans"
                      ]
                    },
                    "group_index": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1023
                    },
                    "declared_type": {
                      "enum": [
                        "base",
                        "agent",
                        "llm",
                        "retriever",
                        "tool"
                      ]
                    },
                    "source_status": {
                      "enum": [
                        "SUCCESS",
                        "ERRORED"
                      ]
                    },
                    "parent_state": {
                      "enum": [
                        "not_reported",
                        "resolved",
                        "unresolved"
                      ]
                    },
                    "parent_pointer": {
                      "anyOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "string",
                          "pattern": "^/testCases/(0|[1-9][0-9]*)/trace/(baseSpans|agentSpans|llmSpans|retrieverSpans|toolSpans)/(0|[1-9][0-9]*)(?![\\s\\S])"
                        }
                      ]
                    },
                    "cycle_member": {
                      "type": "boolean"
                    },
                    "group_type_mismatch": {
                      "type": "boolean"
                    }
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "parent_state": {
                            "const": "resolved"
                          }
                        },
                        "required": [
                          "parent_state"
                        ]
                      },
                      "then": {
                        "properties": {
                          "parent_pointer": {
                            "type": "string",
                            "pattern": "^/testCases/(0|[1-9][0-9]*)/trace/(baseSpans|agentSpans|llmSpans|retrieverSpans|toolSpans)/(0|[1-9][0-9]*)(?![\\s\\S])"
                          }
                        }
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "parent_state": {
                            "const": "not_reported"
                          }
                        },
                        "required": [
                          "parent_state"
                        ]
                      },
                      "then": {
                        "properties": {
                          "parent_pointer": {
                            "type": "null"
                          },
                          "cycle_member": {
                            "const": false
                          }
                        }
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "parent_state": {
                            "const": "unresolved"
                          }
                        },
                        "required": [
                          "parent_state"
                        ]
                      },
                      "then": {
                        "properties": {
                          "parent_pointer": {
                            "type": "null"
                          },
                          "cycle_member": {
                            "const": false
                          }
                        }
                      }
                    }
                  ]
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "trace_availability": {
                      "const": "absent"
                    }
                  },
                  "required": [
                    "trace_availability"
                  ]
                },
                "then": {
                  "properties": {
                    "trace_status": {
                      "type": "null"
                    },
                    "groups": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "baseSpans",
                        "agentSpans",
                        "llmSpans",
                        "retrieverSpans",
                        "toolSpans"
                      ],
                      "properties": {
                        "baseSpans": {
                          "const": "absent"
                        },
                        "agentSpans": {
                          "const": "absent"
                        },
                        "llmSpans": {
                          "const": "absent"
                        },
                        "retrieverSpans": {
                          "const": "absent"
                        },
                        "toolSpans": {
                          "const": "absent"
                        }
                      }
                    },
                    "spans": {
                      "maxItems": 0
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "trace_availability": {
                      "const": "null"
                    }
                  },
                  "required": [
                    "trace_availability"
                  ]
                },
                "then": {
                  "properties": {
                    "trace_status": {
                      "type": "null"
                    },
                    "groups": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "baseSpans",
                        "agentSpans",
                        "llmSpans",
                        "retrieverSpans",
                        "toolSpans"
                      ],
                      "properties": {
                        "baseSpans": {
                          "const": "absent"
                        },
                        "agentSpans": {
                          "const": "absent"
                        },
                        "llmSpans": {
                          "const": "absent"
                        },
                        "retrieverSpans": {
                          "const": "absent"
                        },
                        "toolSpans": {
                          "const": "absent"
                        }
                      }
                    },
                    "spans": {
                      "maxItems": 0
                    }
                  }
                }
              }
            ]
          }
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cases",
            "traces",
            "spans"
          ],
          "properties": {
            "cases": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "total",
                "source_true",
                "source_false",
                "source_unknown"
              ],
              "properties": {
                "total": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 512
                },
                "source_true": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 512
                },
                "source_false": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 512
                },
                "source_unknown": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 512
                }
              }
            },
            "traces": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "absent",
                "null",
                "present",
                "status_success",
                "status_errored",
                "status_unknown"
              ],
              "properties": {
                "absent": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 512
                },
                "null": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 512
                },
                "present": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 512
                },
                "status_success": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 512
                },
                "status_errored": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 512
                },
                "status_unknown": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 512
                }
              }
            },
            "spans": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "total",
                "by_group",
                "by_declared_type",
                "status_success",
                "status_errored",
                "parent_resolved",
                "parent_unresolved",
                "parent_not_reported",
                "cycle_members",
                "group_type_mismatch"
              ],
              "properties": {
                "total": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                },
                "by_group": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "baseSpans",
                    "agentSpans",
                    "llmSpans",
                    "retrieverSpans",
                    "toolSpans"
                  ],
                  "properties": {
                    "baseSpans": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1024
                    },
                    "agentSpans": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1024
                    },
                    "llmSpans": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1024
                    },
                    "retrieverSpans": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1024
                    },
                    "toolSpans": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1024
                    }
                  }
                },
                "by_declared_type": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "base",
                    "agent",
                    "llm",
                    "retriever",
                    "tool"
                  ],
                  "properties": {
                    "base": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1024
                    },
                    "agent": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1024
                    },
                    "llm": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1024
                    },
                    "retriever": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1024
                    },
                    "tool": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1024
                    }
                  }
                },
                "status_success": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                },
                "status_errored": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                },
                "parent_resolved": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                },
                "parent_unresolved": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                },
                "parent_not_reported": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                },
                "cycle_members": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                },
                "group_type_mismatch": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                }
              }
            }
          }
        },
        "limitations": {
          "const": [
            "SOURCE_CLAIMS_UNVERIFIED",
            "SELECTED_FIELDS_ONLY",
            "PLANNED_STEPS_UNKNOWN",
            "INSTRUMENTATION_COMPLETENESS_UNKNOWN",
            "METRICS_AND_TIMING_NOT_ANALYZED",
            "PARENT_LINKS_NOT_CAUSAL_DEPENDENCIES",
            "NO_RETRY_OR_CHRONOLOGY_INFERENCE",
            "SOURCE_HASH_AND_POINTERS_LINKABLE",
            "NO_STATISTICAL_OR_APPROVAL_AUTHORITY",
            "SOURCE_VERSION_UNKNOWN",
            "EXPECTATIONS_NOT_ANALYZED",
            "SOURCE_CASE_SUCCESS_UNINTERPRETED",
            "DATASET_VERSION_NOT_ANALYZED"
          ]
        },
        "next_actions": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "enum": [
              "INSPECT_ERRORED_STEP_CONTEXT",
              "RESOLVE_UNBOUND_PARENT_REFERENCES",
              "INSPECT_CYCLIC_PARENT_LINKS",
              "CHECK_INSTRUMENTATION_COVERAGE_IF_NEEDED"
            ]
          },
          "uniqueItems": true
        },
        "reader_profile": {
          "const": "deepeval.trace-structure.selected-fields.v1"
        }
      }
    },
    "evidence_error": {
      "title": "evidence_error.v1",
      "description": "Invocation or input failure of an evidence pilot command. No successful report was emitted. This is not a measurement verdict.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "code",
        "reason",
        "location",
        "next_action",
        "retryable",
        "exit_code"
      ],
      "properties": {
        "schema": {
          "const": "evidence_error.v1"
        },
        "code": {
          "enum": [
            "USAGE_ERROR",
            "INVALID_INPUT",
            "SOURCE_READ_FAILED",
            "INPUT_LIMIT_EXCEEDED",
            "OUTPUT_LIMIT_EXCEEDED",
            "UNSUPPORTED_PROFILE",
            "UNSUPPORTED_FORMAT",
            "EXPECTED_HASH_MISMATCH",
            "INVALID_MANIFEST",
            "INVALID_ARTIFACT_PATH",
            "SCHEMA_CONFIGURATION_ERROR",
            "COMPUTATION_LIMIT_EXCEEDED",
            "INTERNAL_ERROR",
            "UNSUPPORTED_PLATFORM",
            "INPUT_BINDING_MISMATCH"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Z][A-Z0-9_]*(?![\\s\\S])"
        },
        "location": {
          "type": "string",
          "maxLength": 512
        },
        "next_action": {
          "enum": [
            "CORRECT_ARGUMENTS",
            "CORRECT_INPUT",
            "PROVIDE_REGULAR_LOCAL_FILE",
            "REDUCE_INPUT_SIZE",
            "USE_SUPPORTED_PROFILE",
            "CHECK_EXPECTED_HASH",
            "CORRECT_MANIFEST",
            "CORRECT_ARTIFACT",
            "REINSTALL_PACKAGE",
            "REDUCE_COMPUTATION",
            "REPORT_INTERNAL_ERROR",
            "USE_SUPPORTED_PLATFORM",
            "CORRECT_INPUT_BINDING"
          ]
        },
        "retryable": {
          "const": false
        },
        "exit_code": {
          "const": 2
        }
      }
    },
    "record_error": {
      "title": "record_error.v1",
      "description": "Finite records command failure without caller-supplied diagnostics.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "code",
        "reason",
        "location",
        "next_action",
        "retryable",
        "exit_code"
      ],
      "properties": {
        "schema": {
          "const": "record_error.v1"
        },
        "code": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "location": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^(?:|/(?:root|store|record_id|spec(?:/(?:files|links)(?:/[0-9]+(?:/[a-z_]+)?)?)?|source_base|record|catalog|verification|output))(?![\\s\\S])"
        },
        "next_action": {
          "type": "string"
        },
        "retryable": {
          "const": false
        },
        "exit_code": {
          "const": 2
        }
      },
      "oneOf": [
        {
          "$ref": "#/$defs/record_error__INVALID_SPEC"
        },
        {
          "$ref": "#/$defs/record_error__INVALID_RECORD"
        },
        {
          "$ref": "#/$defs/record_error__INVALID_STORE_LAYOUT"
        },
        {
          "$ref": "#/$defs/record_error__INSECURE_STORE"
        },
        {
          "$ref": "#/$defs/record_error__STORE_NOT_FOUND"
        },
        {
          "$ref": "#/$defs/record_error__RECORD_NOT_FOUND"
        },
        {
          "$ref": "#/$defs/record_error__RECORD_EXISTS"
        },
        {
          "$ref": "#/$defs/record_error__RECORD_CAPTURE_INCOMPLETE"
        },
        {
          "$ref": "#/$defs/record_error__RECORD_NOT_PUBLISHED"
        },
        {
          "$ref": "#/$defs/record_error__SOURCE_READ_FAILED"
        },
        {
          "$ref": "#/$defs/record_error__INPUT_LIMIT_EXCEEDED"
        },
        {
          "$ref": "#/$defs/record_error__RECORD_LIMIT_EXCEEDED"
        },
        {
          "$ref": "#/$defs/record_error__STORE_IO_ERROR"
        },
        {
          "$ref": "#/$defs/record_error__UNSUPPORTED_PLATFORM"
        },
        {
          "$ref": "#/$defs/record_error__USAGE_ERROR"
        },
        {
          "$ref": "#/$defs/record_error__SCHEMA_CONFIGURATION_ERROR"
        },
        {
          "$ref": "#/$defs/record_error__OUTPUT_LIMIT_EXCEEDED"
        },
        {
          "$ref": "#/$defs/record_error__INTERNAL_ERROR"
        },
        {
          "$ref": "#/$defs/record_error__RECORD_FILE_NOT_FOUND"
        },
        {
          "$ref": "#/$defs/record_error__RECORD_FILE_INTEGRITY_MISMATCH"
        },
        {
          "$ref": "#/$defs/record_error__UNSUPPORTED_RECORD_CONTENT"
        }
      ]
    },
    "record_error__INVALID_SPEC": {
      "properties": {
        "code": {
          "const": "INVALID_SPEC"
        },
        "reason": {
          "const": "INVALID_RECORD_SPEC"
        },
        "next_action": {
          "const": "CORRECT_RECORD_SPEC"
        }
      }
    },
    "record_error__INVALID_RECORD": {
      "properties": {
        "code": {
          "const": "INVALID_RECORD"
        },
        "reason": {
          "const": "INVALID_RECORD_MANIFEST"
        },
        "next_action": {
          "const": "SELECT_VALID_RECORD"
        }
      }
    },
    "record_error__INVALID_STORE_LAYOUT": {
      "properties": {
        "code": {
          "const": "INVALID_STORE_LAYOUT"
        },
        "reason": {
          "const": "INVALID_STORE_LAYOUT"
        },
        "next_action": {
          "const": "SELECT_VALID_STORE"
        }
      }
    },
    "record_error__INSECURE_STORE": {
      "properties": {
        "code": {
          "const": "INSECURE_STORE"
        },
        "reason": {
          "const": "INSECURE_STORE_PERMISSIONS"
        },
        "next_action": {
          "const": "SECURE_STORE"
        }
      }
    },
    "record_error__STORE_NOT_FOUND": {
      "properties": {
        "code": {
          "const": "STORE_NOT_FOUND"
        },
        "reason": {
          "const": "STORE_NOT_FOUND"
        },
        "next_action": {
          "const": "CREATE_OR_SELECT_STORE"
        }
      }
    },
    "record_error__RECORD_NOT_FOUND": {
      "properties": {
        "code": {
          "const": "RECORD_NOT_FOUND"
        },
        "reason": {
          "const": "RECORD_NOT_FOUND"
        },
        "next_action": {
          "const": "SELECT_EXISTING_RECORD"
        }
      }
    },
    "record_error__RECORD_EXISTS": {
      "properties": {
        "code": {
          "const": "RECORD_EXISTS"
        },
