    "record_verification": {
      "title": "record_verification.v1",
      "description": "Stored-byte and direct-link integrity findings; valid false is result data, not invocation failure.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "record_id",
        "manifest_digest",
        "valid",
        "files_checked",
        "links_checked",
        "findings",
        "verification_scope"
      ],
      "properties": {
        "schema": {
          "const": "record_verification.v1"
        },
        "record_id": {
          "$ref": "#/$defs/record_verification__record_id"
        },
        "manifest_digest": {
          "$ref": "#/$defs/record_verification__digest"
        },
        "valid": {
          "type": "boolean"
        },
        "files_checked": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "links_checked": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "findings": {
          "description": "At most one deterministic P2 runtime-selected finding per file or direct link; runtime precedence owns coordinate uniqueness.",
          "type": "array",
          "maxItems": 80,
          "items": {
            "$ref": "#/$defs/record_verification__finding"
          },
          "uniqueItems": true
        },
        "verification_scope": {
          "const": "stored_bytes_and_direct_links"
        }
      },
      "if": {
        "properties": {
          "valid": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "findings": {
            "minItems": 1
          }
        }
      }
    },
    "record_verification__record_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,95}(?![\\s\\S])"
    },
    "record_verification__digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "record_verification__logical_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*(?![\\s\\S])"
    },
    "record_verification__finding": {
      "oneOf": [
        {
          "$ref": "#/$defs/record_verification__file_finding"
        },
        {
          "$ref": "#/$defs/record_verification__link_finding"
        }
      ]
    },
    "record_verification__file_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "name",
        "record_id"
      ],
      "properties": {
        "code": {
          "enum": [
            "FILE_MISSING",
            "FILE_NOT_REGULAR",
            "FILE_NOT_PRIVATE",
            "FILE_READ_FAILED",
            "FILE_SIZE_MISMATCH",
            "FILE_DIGEST_MISMATCH"
          ]
        },
        "name": {
          "$ref": "#/$defs/record_verification__logical_name"
        },
        "record_id": {
          "type": "null"
        }
      }
    },
    "record_verification__link_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "name",
        "record_id"
      ],
      "properties": {
        "code": {
          "enum": [
            "LINK_RECORD_NOT_FOUND",
            "LINK_RECORD_NOT_PUBLISHED",
            "LINK_MANIFEST_INVALID",
            "LINK_DIGEST_MISMATCH"
          ]
        },
        "name": {
          "type": "null"
        },
        "record_id": {
          "$ref": "#/$defs/record_verification__record_id"
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "captured",
            "unavailable"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "captured"
              }
            }
          },
          "then": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state",
              "raw_hash",
              "bytes"
            ],
            "properties": {
              "state": {
                "const": "captured"
              },
              "raw_hash": {
                "$ref": "#/$defs/record_verification__digest"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4194304
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "unavailable"
              }
            }
          },
          "then": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state",
              "error"
            ],
            "properties": {
              "state": {
                "const": "unavailable"
              },
              "error": {
                "$ref": "#/$defs/evidence_error"
              }
            }
          }
        }
      ]
    },
    "analysis": {
      "type": "object",
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "result",
            "error"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "result"
              }
            }
          },
          "then": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state",
              "report"
            ],
            "properties": {
              "state": {
                "const": "result"
              },
              "report": {
                "$ref": "#/$defs/langfuse_accounting"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "error"
              }
            }
          },
          "then": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state",
              "phase",
              "error"
            ],
            "properties": {
              "state": {
                "const": "error"
              },
              "phase": {
                "enum": [
                  "acquisition",
                  "analysis"
                ]
              },
              "error": {
                "$ref": "#/$defs/evidence_error"
              }
            }
          }
        }
      ]
    },
    "storage": {
      "type": "object",
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "saved",
            "error"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "saved"
              }
            }
          },
          "then": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state",
              "record_id",
              "manifest_digest",
              "verification"
            ],
            "properties": {
              "state": {
                "const": "saved"
              },
              "record_id": {
                "$ref": "#/$defs/record_verification__record_id"
              },
              "manifest_digest": {
                "$ref": "#/$defs/record_verification__digest"
              },
              "verification": {
                "allOf": [
                  {
                    "$ref": "#/$defs/record_verification"
                  },
                  {
                    "properties": {
                      "valid": {
                        "const": true
                      },
                      "findings": {
                        "maxItems": 0
                      },
                      "links_checked": {
                        "const": 0
                      },
                      "files_checked": {
                        "enum": [
                          2,
                          3,
                          4
                        ]
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "error"
              }
            }
          },
          "then": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state",
              "error",
              "published_record"
            ],
            "properties": {
              "state": {
                "const": "error"
              },
              "error": {
                "$ref": "#/$defs/record_error"
              },
              "published_record": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "record_id",
                      "manifest_digest"
                    ],
                    "properties": {
                      "record_id": {
                        "$ref": "#/$defs/record_verification__record_id"
                      },
                      "manifest_digest": {
                        "$ref": "#/$defs/record_verification__digest"
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "storage": {
            "properties": {
              "state": {
                "const": "saved"
              }
            }
          }
        }
      },
      "then": {
        "allOf": [
          {
            "if": {
              "properties": {
                "sources": {
                  "properties": {
                    "observations": {
                      "properties": {
                        "state": {
                          "const": "unavailable"
                        }
                      }
                    },
                    "scores": {
                      "properties": {
                        "state": {
                          "const": "unavailable"
                        }
                      }
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "storage": {
                  "properties": {
                    "verification": {
                      "properties": {
                        "files_checked": {
                          "const": 2
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "sources": {
                  "properties": {
                    "observations": {
                      "properties": {
                        "state": {
                          "const": "unavailable"
                        }
                      }
                    },
                    "scores": {
                      "properties": {
                        "state": {
                          "const": "captured"
                        }
                      }
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "storage": {
                  "properties": {
                    "verification": {
                      "properties": {
                        "files_checked": {
                          "const": 3
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "sources": {
                  "properties": {
                    "observations": {
                      "properties": {
                        "state": {
                          "const": "captured"
                        }
                      }
                    },
                    "scores": {
                      "properties": {
                        "state": {
                          "const": "unavailable"
                        }
                      }
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "storage": {
                  "properties": {
                    "verification": {
                      "properties": {
                        "files_checked": {
                          "const": 3
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "sources": {
                  "properties": {
                    "observations": {
                      "properties": {
                        "state": {
                          "const": "captured"
                        }
                      }
                    },
                    "scores": {
                      "properties": {
                        "state": {
                          "const": "captured"
                        }
                      }
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "storage": {
                  "properties": {
                    "verification": {
                      "properties": {
                        "files_checked": {
                          "const": 4
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "storage": {
            "properties": {
              "state": {
                "const": "error"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 3
          }
        }
      },
      "else": {
        "if": {
          "properties": {
            "analysis": {
              "properties": {
                "state": {
                  "const": "error"
                }
              }
            }
          }
        },
        "then": {
          "properties": {
            "exit_code": {
              "const": 2
            }
          }
        },
        "else": {
          "properties": {
            "exit_code": {
              "const": 0
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "sources": {
            "properties": {
              "observations": {
                "properties": {
                  "state": {
                    "const": "captured"
                  }
                }
              },
              "scores": {
                "properties": {
                  "state": {
                    "const": "captured"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "if": {
          "properties": {
            "analysis": {
              "properties": {
                "state": {
                  "const": "error"
                }
              }
            }
          }
        },
        "then": {
          "properties": {
            "analysis": {
              "properties": {
                "phase": {
                  "const": "analysis"
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "analysis": {
            "properties": {
              "state": {
                "const": "error"
              },
              "phase": {
