            "properties": {
              "analysis_limitations": {
                "const": []
              },
              "missingness": {
                "properties": {
                  "population_state": {
                    "const": "not_available_analysis_error"
                  },
                  "missing_population_fields": {
                    "const": [
                      "paired_rows",
                      "case_stage_repeat_pairs",
                      "unique_source_case_ids",
                      "stage_case_slots",
                      "primary_repeat_pairs"
                    ]
