{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:underwrite:contract:paired_review_context.v1",
  "title": "paired_review_context.v1",
  "description": "Declared treatment and invariant conditions bound to paired binary evidence inputs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "binding", "conditions"],
  "properties": {
    "schema": {"const": "paired_review_context.v1"},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_digest", "policy_digest"],
      "properties": {
        "input_digest": {"$ref": "#/$defs/digest"},
        "policy_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "conditions": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "#/$defs/condition"}
    },
    "evaluation_history": {"$ref": "#/$defs/evaluationHistory"},
    "case_partition": {"$ref": "#/$defs/casePartition"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nullableValue": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "\\S"}
      ]
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role", "baseline", "candidate"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"},
        "role": {"enum": ["treatment", "invariant"]},
        "baseline": {"$ref": "#/$defs/nullableValue"},
        "candidate": {"$ref": "#/$defs/nullableValue"}
      }
    },
    "nullableId": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"}
      ]
    },
    "predecessor": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["relation"],
          "properties": {"relation": {"enum": ["root", "unknown"]}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["relation", "evaluation_id"],
          "properties": {
            "relation": {"const": "supersedes"},
            "evaluation_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"}
          }
        }
      ]
    },
    "identities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data_digest", "golden_digest", "rubric_digest", "judge_id", "evaluator_id", "outcome_definition_id"],
      "properties": {
        "data_digest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
        "golden_digest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
        "rubric_digest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
        "judge_id": {"$ref": "#/$defs/nullableId"},
        "evaluator_id": {"$ref": "#/$defs/nullableId"},
        "outcome_definition_id": {"$ref": "#/$defs/nullableId"}
      }
    },
    "historyRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluation_id", "result_digest", "declared_status", "invalidation_reason", "predecessor", "identities"],
      "properties": {
        "evaluation_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"},
        "result_digest": {
          "description": "Producer-declared SHA-256 identity of an evaluation-result artifact; the artifact is not loaded or authenticated.",
          "$ref": "#/$defs/digest"
        },
        "declared_status": {"enum": ["active", "invalidated", "unknown"]},
        "invalidation_reason": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "\\S"}
          ]
        },
        "predecessor": {"$ref": "#/$defs/predecessor"},
        "identities": {"$ref": "#/$defs/identities"}
      },
      "allOf": [
        {
          "if": {"properties": {"declared_status": {"const": "invalidated"}}},
          "then": {"properties": {"invalidation_reason": {"type": "string"}}},
          "else": {"properties": {"invalidation_reason": {"type": "null"}}}
        }
      ]
    },
    "evaluationHistory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline_evaluation_id", "candidate_evaluation_id", "records"],
      "properties": {
        "baseline_evaluation_id": {"$ref": "#/$defs/nullableId"},
        "candidate_evaluation_id": {"$ref": "#/$defs/nullableId"},
        "records": {
          "type": "array",
          "maxItems": 32,
          "items": {"$ref": "#/$defs/historyRecord"}
        }
      }
    },
    "casePartition": {
      "description": "An exclusive producer-declared partition of explicit primary case units.",
      "type": "object",
      "additionalProperties": false,
      "required": ["taxonomy_id", "unit", "categories", "assignments"],
      "properties": {
        "taxonomy_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"},
        "unit": {"const": "case"},
        "categories": {
          "type": "array",
          "maxItems": 32,
          "items": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"},
          "uniqueItems": true
        },
        "assignments": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["case_id", "category"],
            "properties": {
              "case_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"},
              "category": {"$ref": "#/$defs/nullableId"}
            }
          }
        }
      }
    }
  }
}
