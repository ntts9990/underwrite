{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:underwrite:contract:cross_artifact_record.v1",
  "title": "cross_artifact_record.v1",
  "description": "Four captured inputs and a mapped descriptive cross-artifact review. Stored-byte integrity does not authenticate producers or authorize approval. Runtime owns equality between captured hashes and report identities, and between published and verified record identities.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "command",
    "source",
    "analysis",
    "storage",
    "exit_code"
  ],
  "properties": {
    "schema": {
      "const": "cross_artifact_record.v1"
    },
    "command": {
      "const": "records review-artifacts"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "members"
      ],
      "properties": {
        "state": {
          "const": "captured"
        },
        "members": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "raw_hash",
                "bytes"
              ],
              "properties": {
                "name": {
                  "const": "goppi-assessment.json"
                },
                "raw_hash": {
                  "$ref": "#/$defs/record_verification__digest"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4194304
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "raw_hash",
                "bytes"
              ],
              "properties": {
                "name": {
                  "const": "goppi-result.json"
                },
                "raw_hash": {
                  "$ref": "#/$defs/record_verification__digest"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4194304
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "raw_hash",
                "bytes"
              ],
              "properties": {
                "name": {
                  "const": "promptfoo.json"
                },
                "raw_hash": {
                  "$ref": "#/$defs/record_verification__digest"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4194304
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "raw_hash",
                "bytes"
              ],
              "properties": {
                "name": {
                  "const": "correspondence.json"
                },
                "raw_hash": {
                  "$ref": "#/$defs/record_verification__digest"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 131072
                }
              }
            }
          ],
          "items": false
        }
      }
    },
    "analysis": {
      "$ref": "#/$defs/analysis"
    },
    "storage": {
      "$ref": "#/$defs/storage"
    },
    "exit_code": {
      "enum": [
        0,
        2,
        3
      ]
    }
  },
  "$defs": {
    "cross_artifact_review": {
      "title": "cross_artifact_review.v1",
      "description": "Descriptive source-claim alignment under optional owner-declared case mapping; never a metric-equivalence, improvement, provenance, or approval decision.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "relation",
        "source_identity",
        "readers",
        "populations",
        "correspondence",
        "finding_counts",
        "improvement",
        "checks",
        "next_verification_tasks",
        "limitations"
      ],
      "properties": {
        "schema": {
          "const": "cross_artifact_review.v1"
        },
        "relation": {
          "enum": [
            "incomparable_on_supplied_evidence",
            "declared_case_mapping_descriptive"
          ]
        },
        "source_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "goppi_assessment_sha256",
            "goppi_result_sha256",
            "promptfoo_export_sha256"
          ],
          "properties": {
            "goppi_assessment_sha256": {
              "$ref": "#/$defs/cross_artifact_review__hash"
            },
            "goppi_result_sha256": {
              "$ref": "#/$defs/cross_artifact_review__hash"
            },
            "promptfoo_export_sha256": {
              "$ref": "#/$defs/cross_artifact_review__hash"
            }
          }
        },
        "readers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "goppi",
            "promptfoo"
          ],
          "properties": {
            "goppi": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "profile",
                "assessment_schema",
                "result_schema"
              ],
              "properties": {
                "profile": {
                  "const": "goppi.c55-selected-fields.v1"
                },
                "assessment_schema": {
                  "const": "goppi.operator_answer_exchange_assessment.v1"
                },
                "result_schema": {
                  "const": "evidence_result.v1"
                }
              }
            },
            "promptfoo": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "profile",
                "producer_version",
                "producer_version_state"
              ],
              "properties": {
                "profile": {
                  "const": "promptfoo.summary-v3.selected-fields.v1"
                },
                "producer_version": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 128
                },
                "producer_version_state": {
                  "enum": [
                    "unknown",
                    "declared"
                  ]
                }
              }
            }
          }
        },
        "populations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "goppi",
            "promptfoo"
          ],
          "properties": {
            "goppi": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "unit",
                "planned_count",
                "item_count",
                "availability"
              ],
              "properties": {
                "unit": {
                  "const": "case"
                },
                "planned_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "item_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "availability": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "observed",
                    "missing",
                    "error",
                    "abstained"
                  ],
                  "properties": {
                    "observed": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "missing": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "error": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "abstained": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            },
            "promptfoo": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "unit",
                "supplied_rows",
                "subject_rows",
                "control_rows",
                "planned_count",
                "category_counts"
              ],
              "properties": {
                "unit": {
                  "const": "row"
                },
                "supplied_rows": {
                  "type": "integer",
                  "minimum": 0
                },
                "subject_rows": {
                  "type": "integer",
                  "minimum": 0
                },
                "control_rows": {
                  "type": "integer",
                  "minimum": 0
                },
                "planned_count": {
                  "type": "null"
                },
                "category_counts": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "successes",
                    "failures",
                    "errors"
                  ],
                  "properties": {
                    "successes": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "failures": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "errors": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          }
        },
        "correspondence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "declaration_sha256",
            "coverage",
            "input_correspondence",
            "semantic_equivalence",
            "condition_alignment",
            "pairs",
            "unmatched_case_indices",
            "unmatched_subject_row_indices"
          ],
          "properties": {
            "declaration_sha256": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/cross_artifact_review__hash"
                }
              ]
            },
            "coverage": {
              "enum": [
                "none",
                "complete",
                "partial"
              ]
            },
            "input_correspondence": {
              "enum": [
                "not_declared",
                "declared_unverified"
              ]
            },
            "semantic_equivalence": {
              "const": "unestablished"
            },
            "condition_alignment": {
              "const": "not_established"
            },
            "pairs": {
              "type": "array",
              "maxItems": 1000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "case_index",
                  "row_index",
                  "goppi_availability",
                  "goppi_value",
                  "promptfoo_source_success",
                  "promptfoo_category",
                  "finding"
                ],
                "properties": {
                  "case_index": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "row_index": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "goppi_availability": {
                    "enum": [
                      "observed",
                      "missing",
                      "error",
                      "abstained"
                    ]
                  },
                  "goppi_value": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  },
                  "promptfoo_source_success": {
                    "type": "boolean"
                  },
                  "promptfoo_category": {
                    "enum": [
                      "successes",
                      "failures",
                      "errors"
                    ]
                  },
                  "finding": {
                    "enum": [
                      "source_boolean_values_equal",
                      "source_boolean_values_different",
                      "value_comparison_ineligible"
                    ]
                  }
                }
              }
            },
            "unmatched_case_indices": {
              "type": "array",
              "maxItems": 1000,
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "uniqueItems": true
            },
            "unmatched_subject_row_indices": {
              "type": "array",
              "maxItems": 1000,
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "uniqueItems": true
            }
          }
        },
        "finding_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "equal",
            "different",
            "ineligible"
          ],
          "properties": {
            "equal": {
              "type": "integer",
              "minimum": 0
            },
            "different": {
              "type": "integer",
              "minimum": 0
            },
            "ineligible": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "improvement": {
          "const": "unknown"
        },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "declaration_source_hashes",
            "goppi_assessment_result_binding",
            "goppi_terminal_controls",
            "goppi_portable_closure",
            "source_authentication"
          ],
          "properties": {
            "declaration_source_hashes": {
              "enum": [
                "matched",
                "not_supplied"
              ]
            },
            "goppi_assessment_result_binding": {
              "const": "checked_selected_fields"
            },
            "goppi_terminal_controls": {
              "const": "not_reperformed"
            },
            "goppi_portable_closure": {
              "const": "not_reperformed"
            },
            "source_authentication": {
              "const": "not_independently_verified"
            }
          }
        },
        "next_verification_tasks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "owner",
              "case_index",
              "row_index"
            ],
            "properties": {
              "code": {
                "enum": [
                  "PROVIDE_SOURCE_BOUND_CASE_CORRESPONDENCE",
                  "DECLARE_REMAINING_CASE_CORRESPONDENCE",
                  "VERIFY_INPUT_AND_METRIC_SEMANTICS",
                  "VERIFY_GOPPI_PORTABLE_CLOSURE",
                  "VERIFY_SOURCE_PROVENANCE",
                  "PROVIDE_COMPARATOR_CONDITIONS",
                  "INSPECT_INELIGIBLE_CASE_EVIDENCE"
                ]
              },
              "owner": {
                "enum": [
                  "evaluation_owner",
                  "source_reviewer",
                  "calling_agent"
                ]
              },
              "case_index": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "row_index": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            }
          }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "enum": [
              "SOURCE_CLAIMS_UNVERIFIED",
              "GOPPI_PORTABLE_CLOSURE_NOT_REPERFORMED",
              "GOPPI_TERMINAL_CONTROLS_NOT_REPERFORMED",
              "INPUT_CORRESPONDENCE_NOT_INDEPENDENTLY_VERIFIED",
              "SEMANTIC_EQUIVALENCE_UNESTABLISHED",
              "PROMPTFOO_PLANNED_POPULATION_UNKNOWN",
              "PROMPTFOO_ROW_ROLES_SOURCE_DECLARED",
              "HASHES_AND_COORDINATES_MAY_IDENTIFY_SOURCES",
              "NO_IMPROVEMENT_OR_APPROVAL"
            ]
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "relation": {
                "const": "incomparable_on_supplied_evidence"
              }
            }
          },
          "then": {
            "properties": {
              "correspondence": {
                "properties": {
                  "declaration_sha256": {
                    "type": "null"
                  },
                  "coverage": {
                    "const": "none"
                  },
                  "input_correspondence": {
                    "const": "not_declared"
                  },
                  "pairs": {
                    "maxItems": 0
                  }
                }
              },
              "checks": {
                "properties": {
                  "declaration_source_hashes": {
                    "const": "not_supplied"
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "correspondence": {
                "properties": {
                  "declaration_sha256": {
                    "$ref": "#/$defs/cross_artifact_review__hash"
                  },
                  "coverage": {
                    "enum": [
                      "complete",
                      "partial"
                    ]
                  },
                  "input_correspondence": {
                    "const": "declared_unverified"
                  }
                }
              },
              "checks": {
                "properties": {
                  "declaration_source_hashes": {
                    "const": "matched"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "cross_artifact_review__hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "evidence_error": {
      "title": "evidence_error.v1",
      "description": "Invocation or input failure of an evidence pilot command. No successful report was emitted. This is not a measurement verdict.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "code",
        "reason",
        "location",
        "next_action",
        "retryable",
        "exit_code"
      ],
      "properties": {
        "schema": {
          "const": "evidence_error.v1"
        },
        "code": {
          "enum": [
            "USAGE_ERROR",
            "INVALID_INPUT",
            "SOURCE_READ_FAILED",
            "INPUT_LIMIT_EXCEEDED",
            "OUTPUT_LIMIT_EXCEEDED",
            "UNSUPPORTED_PROFILE",
            "UNSUPPORTED_FORMAT",
            "EXPECTED_HASH_MISMATCH",
            "INVALID_MANIFEST",
            "INVALID_ARTIFACT_PATH",
            "SCHEMA_CONFIGURATION_ERROR",
            "COMPUTATION_LIMIT_EXCEEDED",
            "INTERNAL_ERROR",
            "UNSUPPORTED_PLATFORM",
            "INPUT_BINDING_MISMATCH"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Z][A-Z0-9_]*(?![\\s\\S])"
        },
        "location": {
          "type": "string",
          "maxLength": 512
        },
        "next_action": {
          "enum": [
            "CORRECT_ARGUMENTS",
            "CORRECT_INPUT",
            "PROVIDE_REGULAR_LOCAL_FILE",
            "REDUCE_INPUT_SIZE",
            "USE_SUPPORTED_PROFILE",
            "CHECK_EXPECTED_HASH",
            "CORRECT_MANIFEST",
            "CORRECT_ARTIFACT",
            "REINSTALL_PACKAGE",
            "REDUCE_COMPUTATION",
            "REPORT_INTERNAL_ERROR",
            "USE_SUPPORTED_PLATFORM",
            "CORRECT_INPUT_BINDING"
          ]
        },
        "retryable": {
          "const": false
        },
        "exit_code": {
          "const": 2
        }
      }
    },
    "record_error": {
      "title": "record_error.v1",
      "description": "Finite records command failure without caller-supplied diagnostics.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "code",
        "reason",
        "location",
        "next_action",
        "retryable",
        "exit_code"
      ],
      "properties": {
        "schema": {
          "const": "record_error.v1"
        },
        "code": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "location": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^(?:|/(?:root|store|record_id|spec(?:/(?:files|links)(?:/[0-9]+(?:/[a-z_]+)?)?)?|source_base|record|catalog|verification|output))(?![\\s\\S])"
        },
        "next_action": {
          "type": "string"
        },
        "retryable": {
          "const": false
        },
        "exit_code": {
          "const": 2
        }
      },
      "oneOf": [
        {
          "$ref": "#/$defs/record_error__INVALID_SPEC"
        },
        {
          "$ref": "#/$defs/record_error__INVALID_RECORD"
        },
        {
          "$ref": "#/$defs/record_error__INVALID_STORE_LAYOUT"
        },
        {
          "$ref": "#/$defs/record_error__INSECURE_STORE"
        },
        {
          "$ref": "#/$defs/record_error__STORE_NOT_FOUND"
        },
        {
          "$ref": "#/$defs/record_error__RECORD_NOT_FOUND"
        },
        {
          "$ref": "#/$defs/record_error__RECORD_EXISTS"
        },
        {
          "$ref": "#/$defs/record_error__RECORD_CAPTURE_INCOMPLETE"
        },
        {
          "$ref": "#/$defs/record_error__RECORD_NOT_PUBLISHED"
        },
        {
          "$ref": "#/$defs/record_error__SOURCE_READ_FAILED"
        },
        {
          "$ref": "#/$defs/record_error__INPUT_LIMIT_EXCEEDED"
        },
        {
          "$ref": "#/$defs/record_error__RECORD_LIMIT_EXCEEDED"
        },
        {
          "$ref": "#/$defs/record_error__STORE_IO_ERROR"
        },
        {
          "$ref": "#/$defs/record_error__UNSUPPORTED_PLATFORM"
        },
        {
          "$ref": "#/$defs/record_error__USAGE_ERROR"
        },
        {
          "$ref": "#/$defs/record_error__SCHEMA_CONFIGURATION_ERROR"
        },
        {
          "$ref": "#/$defs/record_error__OUTPUT_LIMIT_EXCEEDED"
        },
        {
          "$ref": "#/$defs/record_error__INTERNAL_ERROR"
        },
        {
          "$ref": "#/$defs/record_error__RECORD_FILE_NOT_FOUND"
        },
        {
          "$ref": "#/$defs/record_error__RECORD_FILE_INTEGRITY_MISMATCH"
        },
        {
          "$ref": "#/$defs/record_error__UNSUPPORTED_RECORD_CONTENT"
        }
      ]
    },
    "record_error__INVALID_SPEC": {
      "properties": {
        "code": {
          "const": "INVALID_SPEC"
        },
        "reason": {
          "const": "INVALID_RECORD_SPEC"
        },
        "next_action": {
          "const": "CORRECT_RECORD_SPEC"
        }
      }
    },
    "record_error__INVALID_RECORD": {
      "properties": {
        "code": {
          "const": "INVALID_RECORD"
        },
        "reason": {
          "const": "INVALID_RECORD_MANIFEST"
        },
        "next_action": {
          "const": "SELECT_VALID_RECORD"
        }
      }
    },
    "record_error__INVALID_STORE_LAYOUT": {
      "properties": {
        "code": {
          "const": "INVALID_STORE_LAYOUT"
        },
        "reason": {
          "const": "INVALID_STORE_LAYOUT"
        },
        "next_action": {
          "const": "SELECT_VALID_STORE"
        }
      }
    },
    "record_error__INSECURE_STORE": {
      "properties": {
        "code": {
          "const": "INSECURE_STORE"
        },
        "reason": {
          "const": "INSECURE_STORE_PERMISSIONS"
        },
        "next_action": {
          "const": "SECURE_STORE"
        }
      }
    },
    "record_error__STORE_NOT_FOUND": {
      "properties": {
        "code": {
          "const": "STORE_NOT_FOUND"
        },
        "reason": {
          "const": "STORE_NOT_FOUND"
        },
        "next_action": {
          "const": "CREATE_OR_SELECT_STORE"
        }
      }
    },
    "record_error__RECORD_NOT_FOUND": {
      "properties": {
        "code": {
          "const": "RECORD_NOT_FOUND"
        },
        "reason": {
          "const": "RECORD_NOT_FOUND"
        },
        "next_action": {
          "const": "SELECT_EXISTING_RECORD"
        }
      }
    },
    "record_error__RECORD_EXISTS": {
      "properties": {
        "code": {
          "const": "RECORD_EXISTS"
        },
        "reason": {
          "const": "RECORD_ALREADY_EXISTS"
        },
        "next_action": {
          "const": "USE_NEW_RECORD_ID"
        }
      }
    },
    "record_error__RECORD_CAPTURE_INCOMPLETE": {
      "properties": {
        "code": {
          "const": "RECORD_CAPTURE_INCOMPLETE"
        },
        "reason": {
          "const": "RECORD_CAPTURE_INCOMPLETE"
        },
        "next_action": {
          "const": "USE_NEW_RECORD_ID"
        }
      }
    },
    "record_error__RECORD_NOT_PUBLISHED": {
      "properties": {
        "code": {
          "const": "RECORD_NOT_PUBLISHED"
        },
        "reason": {
          "const": "RECORD_NOT_PUBLISHED"
        },
        "next_action": {
          "const": "SELECT_PUBLISHED_RECORD"
        }
      }
    },
    "record_error__SOURCE_READ_FAILED": {
      "properties": {
        "code": {
          "const": "SOURCE_READ_FAILED"
        },
        "reason": {
          "const": "SOURCE_READ_FAILED"
        },
        "next_action": {
          "const": "CHECK_SOURCE_FILE"
        }
      }
