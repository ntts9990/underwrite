{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:underwrite:contract:deepeval_trace_index.v1",
  "title": "deepeval_trace_index.v1",
  "description": "Selected case and span structure; no metric or causal judgment.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source",
    "raw_hash",
    "rule_profile",
    "scope",
    "cases",
    "counts",
    "limitations",
    "next_actions"
  ],
  "properties": {
    "schema": {
      "const": "deepeval_trace_index.v1"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "format_version",
        "claims_verified"
      ],
      "properties": {
        "format": {
          "const": "deepeval.test-run"
        },
        "format_version": {
          "const": "4.2.8"
        },
        "claims_verified": {
          "const": false
        }
      }
    },
    "raw_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
    },
    "rule_profile": {
      "const": "deepeval.trace-index.v1"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "case_roster",
        "selected_fields_only",
        "planned_steps",
        "instrumentation_completeness",
        "source_claims_verified"
      ],
      "properties": {
        "unit": {
          "const": "observed_span"
        },
        "case_roster": {
          "const": "supplied_test_cases"
        },
        "selected_fields_only": {
          "const": true
        },
        "planned_steps": {
          "const": "unknown"
        },
        "instrumentation_completeness": {
          "const": "unknown"
        },
        "source_claims_verified": {
          "const": false
        }
      }
    },
    "cases": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_index",
          "pointer",
          "source_success",
          "trace_availability",
          "trace_status",
          "groups",
          "spans"
        ],
        "properties": {
          "case_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 511
          },
          "pointer": {
            "type": "string",
            "pattern": "^/testCases/(0|[1-9][0-9]*)(?![\\s\\S])"
          },
          "source_success": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "trace_availability": {
            "enum": [
              "absent",
              "null",
              "present"
            ]
          },
          "trace_status": {
            "enum": [
              "SUCCESS",
              "ERRORED",
              null
            ]
          },
          "groups": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "baseSpans",
              "agentSpans",
              "llmSpans",
              "retrieverSpans",
              "toolSpans"
            ],
            "properties": {
              "baseSpans": {
                "enum": [
                  "absent",
                  "null",
                  "empty",
                  "present"
                ]
              },
              "agentSpans": {
                "enum": [
                  "absent",
                  "null",
                  "empty",
                  "present"
                ]
              },
              "llmSpans": {
                "enum": [
                  "absent",
                  "null",
                  "empty",
                  "present"
                ]
              },
              "retrieverSpans": {
                "enum": [
                  "absent",
                  "null",
                  "empty",
                  "present"
                ]
              },
              "toolSpans": {
                "enum": [
                  "absent",
                  "null",
                  "empty",
                  "present"
                ]
              }
            }
          },
          "spans": {
            "type": "array",
            "maxItems": 1024,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "span_index",
                "pointer",
                "group",
                "group_index",
                "declared_type",
                "source_status",
                "parent_state",
                "parent_pointer",
                "cycle_member",
                "group_type_mismatch"
              ],
              "properties": {
                "span_index": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1023
                },
                "pointer": {
                  "type": "string",
                  "pattern": "^/testCases/(0|[1-9][0-9]*)/trace/(baseSpans|agentSpans|llmSpans|retrieverSpans|toolSpans)/(0|[1-9][0-9]*)(?![\\s\\S])"
                },
                "group": {
                  "enum": [
                    "baseSpans",
                    "agentSpans",
                    "llmSpans",
                    "retrieverSpans",
                    "toolSpans"
                  ]
                },
                "group_index": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1023
                },
                "declared_type": {
                  "enum": [
                    "base",
                    "agent",
                    "llm",
                    "retriever",
                    "tool"
                  ]
                },
                "source_status": {
                  "enum": [
                    "SUCCESS",
                    "ERRORED"
                  ]
                },
                "parent_state": {
                  "enum": [
                    "not_reported",
                    "resolved",
                    "unresolved"
                  ]
                },
                "parent_pointer": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "pattern": "^/testCases/(0|[1-9][0-9]*)/trace/(baseSpans|agentSpans|llmSpans|retrieverSpans|toolSpans)/(0|[1-9][0-9]*)(?![\\s\\S])"
                    }
                  ]
                },
                "cycle_member": {
                  "type": "boolean"
                },
                "group_type_mismatch": {
                  "type": "boolean"
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "parent_state": {
                        "const": "resolved"
                      }
                    },
                    "required": [
                      "parent_state"
                    ]
                  },
                  "then": {
                    "properties": {
                      "parent_pointer": {
                        "type": "string",
                        "pattern": "^/testCases/(0|[1-9][0-9]*)/trace/(baseSpans|agentSpans|llmSpans|retrieverSpans|toolSpans)/(0|[1-9][0-9]*)(?![\\s\\S])"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "parent_state": {
                        "const": "not_reported"
                      }
                    },
                    "required": [
                      "parent_state"
                    ]
                  },
                  "then": {
                    "properties": {
                      "parent_pointer": {
                        "type": "null"
                      },
                      "cycle_member": {
                        "const": false
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "parent_state": {
                        "const": "unresolved"
                      }
                    },
                    "required": [
                      "parent_state"
                    ]
                  },
                  "then": {
                    "properties": {
                      "parent_pointer": {
                        "type": "null"
                      },
                      "cycle_member": {
                        "const": false
                      }
                    }
                  }
                }
              ]
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "trace_availability": {
                  "const": "absent"
                }
              },
              "required": [
                "trace_availability"
              ]
            },
            "then": {
              "properties": {
                "trace_status": {
                  "type": "null"
                },
                "groups": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "baseSpans",
                    "agentSpans",
                    "llmSpans",
                    "retrieverSpans",
                    "toolSpans"
                  ],
                  "properties": {
                    "baseSpans": {
                      "const": "absent"
                    },
                    "agentSpans": {
                      "const": "absent"
                    },
                    "llmSpans": {
                      "const": "absent"
                    },
                    "retrieverSpans": {
                      "const": "absent"
                    },
                    "toolSpans": {
                      "const": "absent"
                    }
                  }
                },
                "spans": {
                  "maxItems": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "trace_availability": {
                  "const": "null"
                }
              },
              "required": [
                "trace_availability"
              ]
            },
            "then": {
              "properties": {
                "trace_status": {
                  "type": "null"
                },
                "groups": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "baseSpans",
                    "agentSpans",
                    "llmSpans",
                    "retrieverSpans",
                    "toolSpans"
                  ],
                  "properties": {
                    "baseSpans": {
                      "const": "absent"
                    },
                    "agentSpans": {
                      "const": "absent"
                    },
                    "llmSpans": {
                      "const": "absent"
                    },
                    "retrieverSpans": {
                      "const": "absent"
                    },
                    "toolSpans": {
                      "const": "absent"
                    }
                  }
                },
                "spans": {
                  "maxItems": 0
                }
              }
            }
          }
        ]
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cases",
        "traces",
        "spans"
      ],
      "properties": {
        "cases": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total",
            "source_true",
            "source_false",
            "source_unknown"
          ],
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 512
            },
            "source_true": {
              "type": "integer",
              "minimum": 0,
              "maximum": 512
            },
            "source_false": {
              "type": "integer",
              "minimum": 0,
              "maximum": 512
            },
            "source_unknown": {
              "type": "integer",
              "minimum": 0,
              "maximum": 512
            }
          }
        },
        "traces": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "absent",
            "null",
            "present",
            "status_success",
            "status_errored",
            "status_unknown"
          ],
          "properties": {
            "absent": {
              "type": "integer",
              "minimum": 0,
              "maximum": 512
            },
            "null": {
              "type": "integer",
              "minimum": 0,
              "maximum": 512
            },
            "present": {
              "type": "integer",
              "minimum": 0,
              "maximum": 512
            },
            "status_success": {
              "type": "integer",
              "minimum": 0,
              "maximum": 512
            },
            "status_errored": {
              "type": "integer",
              "minimum": 0,
              "maximum": 512
            },
            "status_unknown": {
              "type": "integer",
              "minimum": 0,
              "maximum": 512
            }
          }
        },
        "spans": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total",
            "by_group",
            "by_declared_type",
            "status_success",
            "status_errored",
            "parent_resolved",
            "parent_unresolved",
            "parent_not_reported",
            "cycle_members",
            "group_type_mismatch"
          ],
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1024
            },
            "by_group": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "baseSpans",
                "agentSpans",
                "llmSpans",
                "retrieverSpans",
                "toolSpans"
              ],
              "properties": {
                "baseSpans": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                },
                "agentSpans": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                },
                "llmSpans": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                },
                "retrieverSpans": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                },
                "toolSpans": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                }
              }
            },
            "by_declared_type": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "base",
                "agent",
                "llm",
                "retriever",
                "tool"
              ],
              "properties": {
                "base": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                },
                "agent": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                },
                "llm": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                },
                "retriever": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                },
                "tool": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                }
              }
            },
            "status_success": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1024
            },
            "status_errored": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1024
            },
            "parent_resolved": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1024
            },
            "parent_unresolved": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1024
            },
            "parent_not_reported": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1024
            },
            "cycle_members": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1024
            },
            "group_type_mismatch": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1024
            }
          }
        }
      }
    },
    "limitations": {
      "const": [
        "SOURCE_CLAIMS_UNVERIFIED",
        "SELECTED_FIELDS_ONLY",
        "PLANNED_STEPS_UNKNOWN",
        "INSTRUMENTATION_COMPLETENESS_UNKNOWN",
        "METRICS_AND_TIMING_NOT_ANALYZED",
        "PARENT_LINKS_NOT_CAUSAL_DEPENDENCIES",
        "NO_RETRY_OR_CHRONOLOGY_INFERENCE",
        "SOURCE_HASH_AND_POINTERS_LINKABLE",
        "NO_STATISTICAL_OR_APPROVAL_AUTHORITY"
      ]
    },
    "next_actions": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "enum": [
          "INSPECT_ERRORED_STEP_CONTEXT",
          "RESOLVE_UNBOUND_PARENT_REFERENCES",
          "INSPECT_CYCLIC_PARENT_LINKS",
          "CHECK_INSTRUMENTATION_COVERAGE_IF_NEEDED"
        ]
      },
      "uniqueItems": true
    }
  }
}
